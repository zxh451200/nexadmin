import { keepPreviousData, useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
import { api } from '@/framework/request/http'
import type { Page, PageQuery } from '@/framework/request/types'
[[- if .UsesUpload]]
import type { UploadedFile } from '@/framework/upload/types'
[[- end]]

export interface [[.Pascal]] {
  id: string
[[- range .Fields]]
  [[.Camel]]: [[.TSType]]
[[- end]]
  createdAt: string
  updatedAt: string
}

export interface [[.Pascal]]Form {
[[- range .FormFields]]
  [[.Camel]]: [[.TSType]]
[[- end]]
}

/** 列表查询：keyword 与各筛选项（字典 / 引用字段的值）。 */
export type [[.Pascal]]Query = PageQuery

const KEY = ['[[.Name]]'] as const

export function use[[.Pascal]]List(query: [[.Pascal]]Query) {
  return useQuery({
    queryKey: [...KEY, 'list', query],
    queryFn: () => api.get<Page<[[.Pascal]]>>('/[[.Plural]]', query),
    placeholderData: keepPreviousData,
  })
}

export function useSave[[.Pascal]]() {
  const qc = useQueryClient()
  return useMutation({
    mutationFn: ({ id, data }: { id?: string; data: [[.Pascal]]Form }) =>
      id ? api.put<[[.Pascal]]>(`/[[.Plural]]/${id}`, data) : api.post<[[.Pascal]]>('/[[.Plural]]', data),
    onSuccess: () => qc.invalidateQueries({ queryKey: KEY }),
  })
}

export function useDelete[[.Pascal]]s() {
  const qc = useQueryClient()
  return useMutation({
    mutationFn: (ids: string[]) =>
      ids.length === 1 ? api.del(`/[[.Plural]]/${ids[0]}`) : api.del('/[[.Plural]]', { ids: ids.join(',') }),
    onSuccess: () => qc.invalidateQueries({ queryKey: KEY }),
  })
}
[[- if .Sortable]]

/** 拖动排序：提交同一列表的完整 id 顺序；失败（含 409 列表已变化）后重新拉取即回滚。 */
export function useSort[[.Pascal]]s() {
  const qc = useQueryClient()
  return useMutation({
    mutationFn: (ids: string[]) => api.put<null>('/[[.Plural]]/sort', { ids }),
    onSettled: () => qc.invalidateQueries({ queryKey: KEY }),
  })
}
[[- end]]

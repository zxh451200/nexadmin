{{define "content"}}
<article class="sl-section sl-article">
  <div class="sl-wrap sl-article-in">
    <header class="sl-article-head">
      {{if .Post.PublishedAt}}<time class="sl-article-date">{{fmtDate .Lang .Post.PublishedAt}}</time>{{end}}
      {{if or .Post.Author .Post.Views}}<p class="sl-article-meta">{{if .Post.Author}}{{.Post.Author}} · {{end}}{{if .Post.Views}}{{.T "post.views"}}：{{.Post.Views}}{{end}}</p>{{end}}
      <h1 class="sl-page-title">{{.Post.Title}}</h1>
    </header>
    {{if .Post.CoverURL}}<img class="sl-article-cover" src="{{.Post.CoverURL}}" alt="">{{end}}
    <div class="sl-article-body">{{safeHTML .Post.Content}}</div>
    {{if or .Post.Categories .Post.Tags}}
    <footer class="sl-article-terms">
      {{if .Post.Categories}}
      <p class="sl-article-term"><span class="sl-article-term-label">{{.T "post.categoryLabel"}}</span>{{range .Post.Categories}}<a class="sl-chip" href="{{$.URL "/news"}}?category={{.Slug}}">{{.Title}}</a>{{end}}</p>
      {{end}}
      {{if .Post.Tags}}
      <p class="sl-article-term"><span class="sl-article-term-label">{{.T "post.tagLabel"}}</span>{{range .Post.Tags}}<a class="sl-chip" href="{{$.URL "/news"}}?tag={{.Slug}}">{{.Name}}</a>{{end}}</p>
      {{end}}
    </footer>
    {{end}}
    <p class="sl-back"><a href="{{.URL "/news"}}">← {{.T "news.back"}}</a></p>
  </div>
</article>
{{end}}

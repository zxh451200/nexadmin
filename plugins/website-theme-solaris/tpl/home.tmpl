{{define "content"}}
<section class="sl-hero">
  <div class="sl-hero-media">
    <img src="/website-assets/theme/solaris/assets/sl-hero.webp" alt="{{.TF "theme.solaris.heroShotAlt" .SiteName}}" decoding="async" fetchpriority="high">
  </div>
  <div class="sl-wrap sl-hero-inner">
    <div class="sl-hero-copy" data-reveal>
      <p class="sl-eyebrow">{{.T "theme.solaris.heroBadge"}}</p>
      <h1 class="sl-hero-title">
        {{- range $i, $line := titleLines .HomeTitle}}{{if $i}}<br>{{end}}<span class="sl-hero-accent{{$i}}">{{$line}}</span>{{end -}}
      </h1>
      {{if .HomeSubtitle}}<p class="sl-hero-sub">{{.HomeSubtitle}}</p>{{end}}
      <div class="sl-hero-cta">
        {{if .HomeCTALabel}}<a class="sl-btn sl-btn-amber" href="{{.URL .HomeCTAHref}}">{{.HomeCTALabel}} <span aria-hidden="true">→</span></a>{{end}}
        <a class="sl-btn sl-btn-ghost-green" href="{{.URL "/products"}}">{{.T "theme.solaris.exploreSolutions"}} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
  <div class="sl-wrap sl-hero-statswrap">
    <div class="sl-hero-stats">
      <div class="sl-stat"><strong>500+</strong><span>{{.T "theme.solaris.stat1"}}</span></div>
      <div class="sl-stat"><strong>40+</strong><span>{{.T "theme.solaris.stat2"}}</span></div>
      <div class="sl-stat"><strong>10+ GWh</strong><span>{{.T "theme.solaris.stat3"}}</span></div>
    </div>
  </div>
</section>

<section class="sl-service" aria-label="{{.T "theme.solaris.serviceStrip"}}">
  <div class="sl-wrap sl-service-grid">
    {{range .Features}}
    <div class="sl-service-item" data-reveal>
      <span class="sl-service-ico" aria-hidden="true">{{icon .Icon}}</span>
      <div class="sl-service-text">
        <strong>{{.Title}}</strong>
        {{if .Description}}<span>{{.Description}}</span>{{end}}
      </div>
    </div>
    {{end}}
  </div>
</section>

<section class="sl-philosophy" id="company">
  <div class="sl-wrap sl-philosophy-grid">
    <p class="sl-bigfig" data-reveal>01</p>
    <div class="sl-philosophy-copy" data-reveal>
      <p class="sl-eyebrow">{{.T "theme.solaris.philosophyEyebrow"}}</p>
      <h2>{{.T "theme.solaris.philosophyTitle"}}</h2>
      <p class="sl-philosophy-sub">{{.T "theme.solaris.philosophySub"}}</p>
      {{range .Navs}}{{if eq .Href "/p/about"}}<a class="sl-more" href="{{$.URL .Href}}">{{$.T "theme.solaris.ourStory"}} <span aria-hidden="true">→</span></a>{{end}}{{end}}
    </div>
    <p class="sl-philosophy-side" data-reveal>{{.T "theme.solaris.philosophySide"}}</p>
  </div>
</section>

{{if .Products}}
<section class="sl-section" id="solutions">
  <div class="sl-wrap">
    <header class="sl-sect-head" data-reveal>
      <div>
        <p class="sl-eyebrow">{{.T "theme.solaris.solutionsEyebrow"}}</p>
        <h2>{{.T "theme.solaris.solutionsTitle"}}</h2>
        <p class="sl-sect-sub">{{.T "theme.solaris.solutionsSub"}}</p>
      </div>
      <a class="sl-more" href="{{.URL "/products"}}">{{.T "theme.solaris.viewAllProducts"}} <span aria-hidden="true">→</span></a>
    </header>
    <div class="sl-product-grid">
      {{range .Products}}
      <a class="sl-product-card" href="{{$.URL "/products"}}/{{.Slug}}" data-reveal>
        <span class="sl-product-cover"><img src="{{.CoverURL}}" alt="{{.Title}}" loading="lazy"></span>
        <span class="sl-product-name">{{.Title}}</span>
        {{if .Summary}}<span class="sl-product-summary">{{.Summary}}</span>{{end}}
        <span class="sl-product-more">{{$.T "theme.solaris.learnMore"}} <span aria-hidden="true">→</span></span>
      </a>
      {{end}}
    </div>
  </div>
</section>
{{end}}

{{if .Features}}
<section class="sl-section sl-advantages" id="advantages">
  <div class="sl-wrap">
    <header class="sl-sect-head" data-reveal>
      <div>
        <h2 class="sl-adv-title">{{.T "theme.solaris.advantagesTitle"}}</h2>
      </div>
    </header>
    <div class="sl-adv-grid">
      {{range slice .Features 0 3}}
      <article class="sl-adv-card" data-reveal>
        <span class="sl-adv-ico" aria-hidden="true">{{icon .Icon}}</span>
        <h3>{{.Title}}</h3>
        <p>{{.Description}}</p>
      </article>
      {{end}}
    </div>
  </div>
</section>
{{end}}

<section class="sl-campus">
  <div class="sl-wrap sl-campus-band" data-reveal>
    <div class="sl-campus-copy">
      <p class="sl-eyebrow">{{.T "theme.solaris.campusBadge"}}</p>
      <h2>{{.T "theme.solaris.campusTitle"}}</h2>
      <p>{{.T "theme.solaris.campusSub"}}</p>
      <a class="sl-btn sl-btn-amber" href="{{.URL "/products"}}">{{.T "theme.solaris.exploreProjects"}} <span aria-hidden="true">→</span></a>
    </div>
    <img src="/website-assets/theme/solaris/assets/sl-campus.webp" alt="{{.T "theme.solaris.campusShotAlt"}}" loading="lazy">
  </div>
</section>

<section class="sl-section" id="applications">
  <div class="sl-wrap">
    <header class="sl-sect-head" data-reveal>
      <div>
        <p class="sl-eyebrow">{{.T "theme.solaris.applicationsEyebrow"}}</p>
        <h2>{{.T "theme.solaris.applicationsTitle"}}</h2>
        <p class="sl-sect-sub">{{.T "theme.solaris.applicationsSub"}}</p>
      </div>
    </header>
    <div class="sl-app-grid">
      <a class="sl-app-card" href="{{.URL "/products"}}" data-reveal>
        <img src="/website-assets/theme/solaris/assets/sl-industrial.webp" alt="" loading="lazy">
        <span class="sl-app-name">{{.T "theme.solaris.app1"}}</span>
        <span class="sl-app-sub">{{.T "theme.solaris.app1Sub"}}</span>
      </a>
      <a class="sl-app-card" href="{{.URL "/products"}}" data-reveal>
        <img src="/website-assets/theme/solaris/assets/sl-commercial.webp" alt="" loading="lazy">
        <span class="sl-app-name">{{.T "theme.solaris.app2"}}</span>
        <span class="sl-app-sub">{{.T "theme.solaris.app2Sub"}}</span>
      </a>
      <a class="sl-app-card" href="{{.URL "/products"}}" data-reveal>
        <img src="/website-assets/theme/solaris/assets/sl-solar.webp" alt="" loading="lazy">
        <span class="sl-app-name">{{.T "theme.solaris.app3"}}</span>
        <span class="sl-app-sub">{{.T "theme.solaris.app3Sub"}}</span>
      </a>
      <a class="sl-app-card" href="{{.URL "/products"}}" data-reveal>
        <img src="/website-assets/theme/solaris/assets/sl-microgrid.webp" alt="" loading="lazy">
        <span class="sl-app-name">{{.T "theme.solaris.app4"}}</span>
        <span class="sl-app-sub">{{.T "theme.solaris.app4Sub"}}</span>
      </a>
    </div>
  </div>
</section>

<section class="sl-section sl-how" id="how">
  <div class="sl-wrap">
    <header class="sl-sect-head" data-reveal>
      <div>
        <p class="sl-eyebrow">{{.T "theme.solaris.howEyebrow"}}</p>
        <h2>{{.T "theme.solaris.howTitle"}}</h2>
        <p class="sl-sect-sub">{{.T "theme.solaris.howSub"}}</p>
      </div>
    </header>
    <div class="sl-how-grid">
      <ol class="sl-how-steps" data-reveal>
        <li><span class="sl-how-num">01</span><div><strong>{{.T "theme.solaris.step1"}}</strong><span>{{.T "theme.solaris.step1Sub"}}</span></div></li>
        <li><span class="sl-how-num">02</span><div><strong>{{.T "theme.solaris.step2"}}</strong><span>{{.T "theme.solaris.step2Sub"}}</span></div></li>
        <li><span class="sl-how-num">03</span><div><strong>{{.T "theme.solaris.step3"}}</strong><span>{{.T "theme.solaris.step3Sub"}}</span></div></li>
        <li><span class="sl-how-num">04</span><div><strong>{{.T "theme.solaris.step4"}}</strong><span>{{.T "theme.solaris.step4Sub"}}</span></div></li>
      </ol>
      <figure class="sl-how-diagram" data-reveal>
        <img src="/website-assets/theme/solaris/assets/sl-process.webp" alt="{{.T "theme.solaris.howDiagramAlt"}}" loading="lazy">
      </figure>
    </div>
  </div>
</section>

{{$hasCases := false}}{{range .Posts}}{{if hasTerm . "cases"}}{{$hasCases = true}}{{end}}{{end}}
{{if $hasCases}}
<section class="sl-section" id="projects">
  <div class="sl-wrap">
    <header class="sl-sect-head" data-reveal>
      <div>
        <p class="sl-eyebrow">{{.T "theme.solaris.projectsEyebrow"}}</p>
        <h2>{{.T "theme.solaris.projectsTitle"}}</h2>
        <p class="sl-sect-sub">{{.T "theme.solaris.projectsSub"}}</p>
      </div>
      <a class="sl-more" href="{{.URL "/news"}}">{{.T "theme.solaris.viewAllProjects"}} <span aria-hidden="true">→</span></a>
    </header>
    <div class="sl-project-grid">
      {{range .Posts}}{{if hasTerm . "cases"}}
      <a class="sl-project-card" href="{{$.URL "/news"}}/{{.Slug}}" data-reveal>
        {{if .CoverURL}}<span class="sl-project-cover"><img src="{{.CoverURL}}" alt="" loading="lazy"></span>{{end}}
        <span class="sl-project-body">
          {{range .Categories}}{{if eq .Slug "cases"}}<span class="sl-term-badge">{{.Title}}</span>{{end}}{{end}}
          <span class="sl-project-title">{{.Title}}</span>
          {{if .Summary}}<span class="sl-project-sub">{{.Summary}}</span>{{end}}
          <span class="sl-project-more">{{$.T "theme.solaris.viewCase"}} <span aria-hidden="true">→</span></span>
        </span>
      </a>
      {{end}}{{end}}
    </div>
  </div>
</section>
{{end}}

<section class="sl-section sl-sustainability" id="sustainability">
  <div class="sl-wrap sl-sustainability-grid">
    <div class="sl-sustainability-copy" data-reveal>
      <p class="sl-eyebrow">{{.T "theme.solaris.sustEyebrow"}}</p>
      <h2>{{.T "theme.solaris.sustTitle"}}</h2>
      <p class="sl-sustainability-sub">{{.T "theme.solaris.sustSub"}}</p>
      <a class="sl-btn sl-btn-amber" href="{{.URL "/contact"}}">{{.T "theme.solaris.sustCta"}} <span aria-hidden="true">→</span></a>
    </div>
    <figure class="sl-sustainability-shot" data-reveal>
      <img src="/website-assets/theme/solaris/assets/sl-sustainability.webp" alt="{{.T "theme.solaris.sustShotAlt"}}" loading="lazy">
    </figure>
    <ul class="sl-sustainability-stats">
      <li><strong>1.2M+</strong><span>{{.T "theme.solaris.sustStat1"}}</span></li>
      <li><strong>10+ GWh</strong><span>{{.T "theme.solaris.sustStat2"}}</span></li>
      <li><strong>40+</strong><span>{{.T "theme.solaris.sustStat3"}}</span></li>
    </ul>
  </div>
</section>

<section class="sl-section sl-voices" id="voices">
  <div class="sl-wrap sl-voices-grid">
    <div data-reveal>
      <p class="sl-eyebrow">{{.T "theme.solaris.voicesEyebrow"}}</p>
      <h2 class="sl-section-title">{{.T "theme.solaris.voicesTitle"}}</h2>
      <div class="sl-quote-list">
        <figure class="sl-quote">
          <span class="sl-quote-avatar" aria-hidden="true">{{.T "theme.solaris.quote1Initial"}}</span>
          <div>
            <blockquote class="sl-quote-text">{{.T "theme.solaris.quote1"}}</blockquote>
            <figcaption class="sl-quote-person"><strong>{{.T "theme.solaris.quote1Name"}}</strong> · {{.T "theme.solaris.quote1Role"}}</figcaption>
          </div>
        </figure>
        <figure class="sl-quote">
          <span class="sl-quote-avatar" aria-hidden="true">{{.T "theme.solaris.quote2Initial"}}</span>
          <div>
            <blockquote class="sl-quote-text">{{.T "theme.solaris.quote2"}}</blockquote>
            <figcaption class="sl-quote-person"><strong>{{.T "theme.solaris.quote2Name"}}</strong> · {{.T "theme.solaris.quote2Role"}}</figcaption>
          </div>
        </figure>
      </div>
    </div>
    <div class="sl-partners" data-reveal>
      <p class="sl-eyebrow">{{.T "theme.solaris.partnersTitle"}}</p>
      <div class="sl-partner-grid">
        <!-- 伙伴为品牌商标，按标识原样呈现，不做翻译 -->
        <span class="sl-partner">VIRGON</span>
        <span class="sl-partner">SUNNOVA</span>
        <span class="sl-partner">ALTERRA</span>
        <span class="sl-partner">NexGen</span>
        <span class="sl-partner">TerraVolt</span>
        <span class="sl-partner">AURORA</span>
      </div>
    </div>
  </div>
</section>

{{if .Posts}}
<section class="sl-section" id="insights">
  <div class="sl-wrap">
    <header class="sl-sect-head" data-reveal>
      <div>
        <p class="sl-eyebrow">{{.T "theme.solaris.insightsEyebrow"}}</p>
        <h2>{{.T "theme.solaris.insightsTitle"}}</h2>
        <p class="sl-sect-sub">{{.T "theme.solaris.insightsSub"}}</p>
      </div>
      <a class="sl-more" href="{{.URL "/news"}}">{{.T "theme.solaris.viewAllArticles"}} <span aria-hidden="true">→</span></a>
    </header>
    <div class="sl-news-grid">
      {{range $i, $p := .Posts}}{{if lt $i 3}}
      <a class="sl-news-card{{if not $p.CoverURL}} is-plain{{end}}" href="{{$.URL "/news"}}/{{$p.Slug}}" data-reveal>
        {{if $p.CoverURL}}<span class="sl-news-cover"><img src="{{$p.CoverURL}}" alt="" loading="lazy"></span>{{end}}
        <span class="sl-news-date">{{if $p.PublishedAt}}{{fmtDate $.Lang $p.PublishedAt}}{{else}}{{fmtDate $.Lang $p.UpdatedAt}}{{end}}</span>
        <span class="sl-news-title">{{$p.Title}}</span>
        {{if $p.Summary}}<span class="sl-news-sub">{{$p.Summary}}</span>{{end}}
        <span class="sl-news-more">{{$.T "theme.solaris.readMore"}} <span aria-hidden="true">→</span></span>
      </a>
      {{end}}{{end}}
    </div>
  </div>
</section>
{{end}}

<section class="sl-cta">
  <div class="sl-wrap sl-cta-grid">
    <div>
      <p class="sl-eyebrow sl-eyebrow-light">{{.T "theme.solaris.ctaEyebrow"}}</p>
      <h2>{{.T "theme.solaris.ctaTitle"}}</h2>
      <p>{{.T "theme.solaris.ctaSub"}}</p>
      <div class="sl-cta-actions">
        <a class="sl-btn sl-btn-amber" href="{{.URL "/contact"}}">{{.T "theme.solaris.quote"}} <span aria-hidden="true">→</span></a>
        {{if .ContactPhone}}<a class="sl-cta-item" href="tel:{{.ContactPhone}}"><strong>{{.T "contact.phone"}}</strong><span>{{.ContactPhone}}</span></a>{{end}}
      </div>
    </div>
    <div class="sl-cta-card">
      <h3>{{.T "theme.solaris.ctaCardTitle"}}</h3>
      <p>{{.T "theme.solaris.ctaCardSub"}}</p>
      <a class="sl-btn sl-btn-dark" href="{{.URL "/contact"}}">{{.T "theme.solaris.ctaCardCta"}} <span aria-hidden="true">→</span></a>
      <ul class="sl-cta-list">
        {{if .ContactEmail}}<li>{{icon "mail"}}<a href="mailto:{{.ContactEmail}}">{{.ContactEmail}}</a></li>{{end}}
        {{if .ContactPhone}}<li>{{icon "phone"}}<a href="tel:{{.ContactPhone}}">{{.ContactPhone}}</a></li>{{end}}
        <li>{{icon "file"}}<a href="{{.BaseURL}}/rss.xml">{{.T "theme.solaris.ctaCardDocs"}}</a></li>
      </ul>
    </div>
  </div>
</section>
{{end}}

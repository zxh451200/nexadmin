{{define "content"}}
<article class="pd-page" data-pd-page>
  <div class="pd-wrap">
    <nav class="pd-crumb" aria-label="{{.T "product.crumbAria"}}">
      <a href="{{.Home}}">{{.T "layout.home"}}</a><span aria-hidden="true">›</span>
      <a href="{{.URL "/products"}}">{{.T "products.title"}}</a>
      {{if .Product.Categories}}<span aria-hidden="true">›</span>{{range $i, $c := .Product.Categories}}{{if $i}} / {{end}}<a href="{{$.URL "/products"}}?category={{$c.Slug}}">{{$c.Title}}</a>{{end}}{{end}}
      <span aria-hidden="true">›</span><span aria-current="page">{{.Product.Title}}</span>
    </nav>

    <div class="pd-top">
      <div class="pd-media">
        {{if or .Product.CoverURL .Product.ProductImages .Product.Video}}
        <div class="pd-gallery" data-product-gallery>
          <div class="pd-stage" data-pd-stage>
            {{if .Product.CoverURL}}<img class="product-gallery-main pd-main-img" src="{{.Product.CoverURL}}" data-zoom="{{.Product.CoverURL}}" alt="{{.Product.Title}}">{{else}}<span class="pd-main-img pd-main-fallback">{{initial .Product.Title}}</span>{{end}}
            <span class="pd-zoom-tip" aria-hidden="true">{{.T "product.zoomTip"}}</span>
          </div>
          {{with .Product.Video}}<button type="button" class="product-gallery-thumb pd-thumb pd-thumb-video" data-video-kind="{{.Kind}}" data-video-src="{{.Src}}" data-video-poster="{{$.Product.CoverURL}}" aria-label="{{$.T "product.playVideo"}}"><span class="pd-thumb-play" aria-hidden="true"></span></button>{{end}}
          {{range .Product.ProductImages}}<button type="button" class="product-gallery-thumb pd-thumb" data-gallery-src="{{.}}" aria-label="{{$.T "products.galleryThumbAria"}}"><img src="{{.}}" alt="" loading="lazy"></button>{{end}}
        </div>
        {{end}}
        {{if and .Product.VideoURL (not .Product.Video)}}<div class="pd-media-tabs"><a href="{{.Product.VideoURL}}" target="_blank" rel="noopener">{{.T "products.watchVideo"}}</a></div>{{end}}
        {{if or .SiteName .ContactEmail .ContactPhone}}
        <div class="pd-supplier">
          <a class="pd-supplier-name" href="{{.Home}}">{{.SiteName}}</a>
          {{if .SiteDesc}}<p class="pd-supplier-desc">{{.SiteDesc}}</p>{{end}}
          {{if .Product.Categories}}<div class="pd-supplier-cats">{{range .Product.Categories}}<span>{{.Title}}</span>{{end}}</div>{{end}}
          <div class="pd-supplier-row">
            {{if .ContactEmail}}<span>{{.ContactEmail}}</span>{{end}}
            {{if .ContactPhone}}<span>{{.ContactPhone}}</span>{{end}}
          </div>
          {{/* 供应商实力档案：对标阿里店铺卡的「成立年份 / 员工 / 年营收 / 主营市场 / 响应」，
               每项留空就整格不渲染，不会出现「年营收：」这种半行 */}}
          {{if or .EstablishedYear .StaffCount .AnnualRevenue .MainMarkets .ResponseTime}}
          <dl class="pd-supplier-stats">
            {{if .EstablishedYear}}<div><dt>{{.T "product.estYear"}}</dt><dd>{{.EstablishedYear}}</dd></div>{{end}}
            {{if .StaffCount}}<div><dt>{{.T "product.staffCount"}}</dt><dd>{{.StaffCount}}</dd></div>{{end}}
            {{if .AnnualRevenue}}<div><dt>{{.T "product.annualRevenue"}}</dt><dd>{{.AnnualRevenue}}</dd></div>{{end}}
            {{if .MainMarkets}}<div><dt>{{.T "product.mainMarkets"}}</dt><dd>{{.MainMarkets}}</dd></div>{{end}}
            {{if .ResponseTime}}<div><dt>{{.T "product.responseTime"}}</dt><dd>{{.ResponseTime}}</dd></div>{{end}}
          </dl>
          {{end}}
        </div>
        {{end}}
      </div>

      <div class="pd-info">
        <h1>{{.Product.Title}}</h1>
        {{/* 评分行对标阿里标题下方的「5.0 (N 评价)」：没有评价整行不渲染 */}}
        {{if .ProductReviews.Total}}
        <div class="pd-rating-row">
          <span class="pd-stars" aria-hidden="true">{{starRow .ProductReviews.AvgValue}}</span>
          <strong>{{.ProductReviews.Average}}</strong>
          <span class="pd-rating-count">{{$.TF "product.reviewsCount" .ProductReviews.Total}}</span>
        </div>
        {{end}}
        <div class="pd-badges">
          {{range .Product.Categories}}<a class="pd-badge" href="{{$.URL "/products"}}?category={{.Slug}}">{{.Title}}</a>{{end}}
          {{if .Product.Views}}<span class="pd-badge pd-badge-quiet">{{.TF "product.views" .Product.Views}}</span>{{end}}
        </div>
        {{if .Product.Certifications}}
        <div class="pd-certs" aria-label="{{.T "product.certifications"}}">
          {{range .Product.Certifications}}<span class="pd-cert">{{uiIcon .Icon "pd-cert-ico"}}<span>{{.Name}}</span></span>{{end}}
        </div>
        {{end}}
        <p class="pd-price">{{if .Product.PriceMin}}{{.Product.Currency}}{{if and .Product.PriceMax (gt .Product.PriceMax .Product.PriceMin)}}{{money .Product.PriceMin}}-{{money .Product.PriceMax}}{{else}}{{money .Product.PriceMin}}{{end}}{{if .Product.PriceUnit}}<span class="pd-price-unit"> / {{.Product.PriceUnit}}</span>{{end}}{{else}}{{.T "product.priceOnRequest"}}{{end}}</p>
        {{if .Product.Moq}}<p class="pd-moq">{{.T "products.moqLabel"}}: {{.Product.Moq}}{{if .Product.PriceUnit}} {{.Product.PriceUnit}}{{end}}</p>{{end}}
        {{$trade := .Product.TradeInfo}}
        {{/* 数量紧跟 MOQ（对齐阿里价格块下方就是数量控件）；阶梯价与 SKU 选型随后 */}}
        <div class="pd-qty" data-pd-qty data-pd-qty-min="{{if gt .Product.Moq 1}}{{.Product.Moq}}{{else}}1{{end}}"{{if .Product.PriceUnit}} data-pd-qty-unit="{{.Product.PriceUnit}}"{{end}}>
          <label class="pd-qty-label" for="pd-qty-input">{{.T "product.quantity"}}</label>
          <div class="pd-stepper">
            <button type="button" class="pd-step" data-pd-qty-minus aria-label="{{.T "product.qtyDec"}}">−</button>
            <input class="pd-step-input" id="pd-qty-input" data-pd-qty-input type="text" inputmode="numeric" autocomplete="off" value="{{if gt .Product.Moq 1}}{{.Product.Moq}}{{else}}1{{end}}" aria-label="{{.T "product.quantity"}}">
            <button type="button" class="pd-step" data-pd-qty-plus aria-label="{{.T "product.qtyInc"}}">+</button>
          </div>
          {{if .Product.PriceUnit}}<span class="pd-qty-unit">{{.Product.PriceUnit}}</span>{{end}}
        </div>
        {{if $trade.Ladder}}
        <div class="pd-ladder" data-pd-ladder data-currency="{{.Product.Currency}}" role="table" aria-label="{{.T "product.priceTiers"}}">
          {{range $trade.Ladder}}<div class="pd-ladder-row" role="row" data-ladder-qty="{{.Qty}}" data-ladder-price="{{.Price}}">
            <span class="pd-ladder-range" role="cell">{{if .Last}}≥{{.Qty}}{{else}}{{.Range}}{{end}}</span>
            <span class="pd-ladder-price" role="cell">{{$.Product.Currency}}{{money .Price}}{{if $.Product.PriceUnit}} <small>/ {{$.Product.PriceUnit}}</small>{{end}}</span>
          </div>{{end}}
        </div>
        {{end}}
        {{if $trade.Skus}}
        <div class="pd-skus" data-pd-skus data-currency="{{.Product.Currency}}" data-base-price="{{.Product.PriceMin}}"{{if .Product.PriceUnit}} data-unit="{{.Product.PriceUnit}}"{{end}}>
          {{range $pi, $prop := $trade.SkuProps}}
          <div class="pd-sku-group" data-sku-prop="{{$prop.Name}}">
            <span class="pd-sku-label">{{$prop.Name}}</span>
            <div class="pd-sku-values">
              {{range $prop.Values}}<button type="button" class="pd-sku-value" data-sku-value="{{.}}">{{.}}</button>{{end}}
            </div>
          </div>
          {{end}}
          {{range $trade.Skus}}<span class="pd-sku-data" hidden data-sku-key="{{.Key}}" data-sku-price="{{.Price}}" data-sku-stock="{{.Stock}}" data-sku-code="{{.Code}}"></span>{{end}}
          <p class="pd-sku-hint" data-pd-sku-hint hidden></p>
        </div>
        {{end}}
        {{if or $trade.Sample $trade.Custom}}
        <div class="pd-keyattrs pd-offers">
          <h2>{{.T "product.sampleAndCustom"}}</h2>
          {{with $trade.Sample}}
          <div class="pd-offer-row">
            <span class="pd-offer-name">{{$.T "product.sampleService"}}</span>
            <span class="pd-offer-meta">{{if .MaxQty}}{{$.T "product.sampleMaxQty"}} {{.MaxQty}}{{end}}{{if .Price}} · {{$.Product.Currency}}{{money .Price}}{{end}}</span>
          </div>
          {{end}}
          {{range $trade.Custom}}
          <div class="pd-offer-row">
            <span class="pd-offer-name">{{if eq .Type "Customized logo"}}{{$.T "product.customLogo"}}{{else if eq .Type "Customized packaging"}}{{$.T "product.customPackaging"}}{{else if eq .Type "Graphic customization"}}{{$.T "product.customGraphic"}}{{else}}{{.Type}}{{end}}</span>
            <span class="pd-offer-meta">{{$.T "product.customMoq"}} {{.Quantity}}</span>
          </div>
          {{end}}
        </div>
        {{end}}
        {{if .Product.ProductSpecs}}
        <div class="pd-keyattrs">
          <h2>{{.T "product.keyAttrs"}}</h2>
          <div class="pd-attr-grid">{{range .Product.ProductSpecs}}<div><span class="pd-attr-label">{{.Label}}</span><span class="pd-attr-value">{{.Value}}</span></div>{{end}}</div>
        </div>
        {{end}}
        {{if .Product.Summary}}<p class="pd-summary">{{.Product.Summary}}</p>{{end}}
      </div>

      <aside class="pd-inquiry" aria-label="{{.T "product.serviceTitle"}}">
        {{$trade := .Product.TradeInfo}}
        {{/* 小计卡置顶对标阿里右栏 Shipping：数量在中栏联动，这里只算账 */}}
        <div class="pd-sum" data-pd-sum data-pd-currency="{{.Product.Currency}}" data-pd-price="{{.Product.PriceMin}}" data-pd-freight="{{.Product.FreightAmount}}"{{if not .Product.PriceMin}} hidden{{end}}>
          <div class="pd-sum-row"><span>{{.T "product.sumProducts"}}</span><span data-pd-sum-products></span></div>
          <div class="pd-sum-row"><span>{{.T "product.sumFreight"}}</span><span data-pd-sum-freight>{{if gt .Product.FreightAmount 0.0}}{{.Product.Currency}}{{money .Product.FreightAmount}}{{else}}{{.T "product.freightTbd"}}{{end}}</span></div>
          <div class="pd-sum-total"><span>{{.T "product.sumTotal"}}</span><span data-pd-sum-total></span></div>
        </div>
        <a id="pd-cta" data-inquiry-open class="pd-cta pd-cta-primary" href="{{.URL "/contact"}}" data-chat-title="{{.Product.Title}}" data-chat-price="{{if .Product.PriceMin}}{{.Product.Currency}}{{money .Product.PriceMin}}{{else}}{{.T "product.priceOnRequest"}}{{end}}" data-chat-moq="{{if .Product.Moq}}{{.T "products.moqLabel"}}: {{.Product.Moq}}{{end}}" data-chat-url="{{.URL "/products"}}/{{.Product.Slug}}" data-chat-cover="{{.Product.CoverURL}}">{{.T "product.sendInquiry"}}</a>
        {{/* 「联系商家」是直接对话入口：装了 IM 就开客服面板并预填开场白；
             没装 IM 时照旧按 href 走邮箱 / 联系页，不能只在 mailto 上挂着等系统邮件客户端 */}}
        <a class="pd-cta pd-cta-secondary" href="{{if .ContactEmail}}mailto:{{.ContactEmail}}{{else}}{{.URL "/contact"}}{{end}}" data-chat-open-product data-chat-intent="contact" data-chat-title="{{.Product.Title}}" data-chat-price="{{if .Product.PriceMin}}{{.Product.Currency}}{{money .Product.PriceMin}}{{else}}{{.T "product.priceOnRequest"}}{{end}}" data-chat-moq="{{if .Product.Moq}}{{.T "products.moqLabel"}}: {{.Product.Moq}}{{end}}" data-chat-url="{{.URL "/products"}}/{{.Product.Slug}}" data-chat-cover="{{.Product.CoverURL}}">{{.T "product.contactSupplier"}}</a>
        <p class="pd-foot-note">{{.TF "product.inquiryNote" .SiteName}}</p>
        <div class="pd-inq-section">
          <strong>{{.T "product.shippingTitle"}}</strong>
          {{if .Product.Port}}<div class="pd-inq-row"><span>{{.T "products.portLabel"}}</span><span>{{.Product.Port}}</span></div>{{end}}
          {{if .Product.LeadTimeDays}}<div class="pd-inq-row"><span>{{.T "products.leadTimeLabel"}}</span><span>{{.TF "products.leadTime" .Product.LeadTimeDays}}</span></div>{{end}}
          {{if .Product.PaymentTerms}}<div class="pd-inq-row"><span>{{.T "products.paymentTerms"}}</span><span>{{.Product.PaymentTerms}}</span></div>{{end}}
          {{with $trade.Supply}}<div class="pd-inq-row"><span>{{$.T "product.supplyCapacity"}}</span><span>{{.Number}} {{.Unit}}{{if .Period}} / {{.Period}}{{end}}</span></div>{{end}}
          {{with $trade.Pkg}}
          {{if .Dim}}<div class="pd-inq-row"><span>{{$.T "product.packageSize"}}</span><span>{{.Dim}}</span></div>{{end}}
          {{if .Weight}}<div class="pd-inq-row"><span>{{$.T "product.grossWeight"}}</span><span>{{.Weight}} kg</span></div>{{end}}
          {{if .Cubic}}<div class="pd-inq-row"><span>{{$.T "product.volumeLabel"}}</span><span>{{.Cubic}} m³</span></div>{{end}}
          {{end}}
        </div>
        <div class="pd-inq-section pd-service">
          <strong>{{.T "product.serviceTitle"}}</strong>
          <div><span aria-hidden="true">✓</span> {{.T "product.serviceQuote"}}</div>
          <div><span aria-hidden="true">✓</span> {{.T "product.serviceSpec"}}</div>
          <div><span aria-hidden="true">✓</span> {{.T "product.serviceDelivery"}}</div>
        </div>
        {{if .Product.PaymentChips}}
        <div class="pd-inq-section pd-pay">
          <strong>{{uiIcon "shield" "pd-pay-ico"}} {{.T "product.paymentTitle"}}</strong>
          <ul class="pd-pay-methods" aria-label="{{.T "product.paymentMethodsAria"}}">
            {{range .Product.PaymentChips}}
            {{/* 品牌项输出各自的官方色图形/字标（白底方块）；贸易术语仍走中性线框图标。 */}}
            <li class="pd-pay-chip pd-pay-{{.Kind}}" title="{{.Label}}" aria-label="{{.Label}}">{{if eq .Kind "visa"}}<span class="pd-logo-visa" aria-hidden="true">VISA</span>{{else if eq .Kind "mc"}}<span class="pd-logo-mc" aria-hidden="true"><i></i><i></i></span>{{else if eq .Kind "paypal"}}<span class="pd-logo-paypal" aria-hidden="true">Pay<b>Pal</b></span>{{else if eq .Kind "apple"}}<span class="pd-logo-apple" aria-hidden="true"></span><span class="pd-logo-apple-pay" aria-hidden="true">Pay</span>{{else if eq .Kind "up"}}<span class="pd-logo-up" aria-hidden="true">UnionPay</span>{{else}}{{if .Icon}}{{uiIcon .Icon "pd-pay-icon"}}{{end}}{{.Label}}{{end}}</li>
            {{end}}
          </ul>
          <p class="pd-pay-note">{{.TF "product.paymentNote" .SiteName}}</p>
        </div>
        {{end}}
      </aside>
    </div>


    {{$trade := .Product.TradeInfo}}
    <div class="pd-sticky" data-pd-sticky>
      <div class="pd-sticky-info">
        <span class="pd-sticky-price">{{if .Product.PriceMin}}{{.Product.Currency}}{{money .Product.PriceMin}}{{else}}{{.T "product.priceOnRequest"}}{{end}}</span>
        <span class="pd-sticky-meta" data-pd-sticky-meta>{{if .Product.Moq}}{{.T "products.moqLabel"}}: {{.Product.Moq}}{{end}}</span>
      </div>
      <button type="button" class="pd-sticky-cta" data-pd-sticky-go>{{.T "product.sendInquiry"}}</button>
    </div>

    <div class="pd-tabs" data-tabs role="tablist">
      {{if .Product.ProductSpecs}}<button type="button" role="tab" id="pd-tab-attrs" aria-controls="pd-panel-attrs" aria-selected="true">{{.T "product.tabAttrs"}}</button>{{end}}
      {{if or .Product.Content .Product.Summary}}<button type="button" role="tab" id="pd-tab-desc" aria-controls="pd-panel-desc" aria-selected="false">{{.T "product.tabDesc"}}</button>{{end}}
      {{if or .Product.PaymentTerms .Product.Moq .Product.LeadTimeDays .Product.Port $trade.Pkg $trade.Supply}}<button type="button" role="tab" id="pd-tab-ship" aria-controls="pd-panel-ship" aria-selected="false">{{.T "product.tabShipping"}}</button>{{end}}
      {{with .ProductReviews}}{{if .Total}}<a class="pd-tab-anchor" href="#pd-reviews">{{$.T "product.tabReviews"}}</a>{{end}}{{end}}
    </div>
    {{if .Product.ProductSpecs}}
    <section class="pd-panel" id="pd-panel-attrs" role="tabpanel" aria-labelledby="pd-tab-attrs">
      <h2>{{.T "product.specTableTitle"}}</h2>
      <div class="pd-spec-table">{{range .Product.ProductSpecs}}<div class="pd-spec-cell"><span class="pd-spec-label">{{.Label}}</span><span>{{.Value}}</span></div>{{end}}</div>
    </section>
    {{end}}
    {{if or .Product.Content .Product.Summary}}
    <section class="pd-panel" id="pd-panel-desc" role="tabpanel" aria-labelledby="pd-tab-desc">
      {{if .Product.Summary}}<p class="pd-summary">{{.Product.Summary}}</p>{{end}}
      {{if .Product.Content}}<div class="article-body pd-body">{{safeHTML .Product.Content}}</div>{{end}}
    </section>
    {{end}}
    {{if or .Product.PaymentTerms .Product.Moq .Product.LeadTimeDays .Product.Port $trade.Pkg $trade.Supply}}
    <section class="pd-panel" id="pd-panel-ship" role="tabpanel" aria-labelledby="pd-tab-ship">
      <h2>{{.T "product.tabShipping"}}</h2>
      <div class="pd-spec-table">
        {{if .Product.Moq}}<div class="pd-spec-cell"><span class="pd-spec-label">{{.T "products.moqLabel"}}</span><span>{{.Product.Moq}} {{.Product.PriceUnit}}</span></div>{{end}}
        {{if .Product.PaymentTerms}}<div class="pd-spec-cell"><span class="pd-spec-label">{{.T "products.paymentTerms"}}</span><span>{{.Product.PaymentTerms}}</span></div>{{end}}
        {{if .Product.LeadTimeDays}}<div class="pd-spec-cell"><span class="pd-spec-label">{{.T "products.leadTimeLabel"}}</span><span>{{.TF "products.leadTime" .Product.LeadTimeDays}}</span></div>{{end}}
        {{if .Product.Port}}<div class="pd-spec-cell"><span class="pd-spec-label">{{.T "products.portLabel"}}</span><span>{{.Product.Port}}</span></div>{{end}}
        {{with $trade.Supply}}<div class="pd-spec-cell"><span class="pd-spec-label">{{$.T "product.supplyCapacity"}}</span><span>{{.Number}} {{.Unit}}{{if .Period}} / {{.Period}}{{end}}</span></div>{{end}}
        {{with $trade.Pkg}}
        {{if .Dim}}<div class="pd-spec-cell"><span class="pd-spec-label">{{$.T "product.packageSize"}}</span><span>{{.Dim}}</span></div>{{end}}
        {{if .Weight}}<div class="pd-spec-cell"><span class="pd-spec-label">{{$.T "product.grossWeight"}}</span><span>{{.Weight}} kg</span></div>{{end}}
        {{if .Cubic}}<div class="pd-spec-cell"><span class="pd-spec-label">{{$.T "product.volumeLabel"}}</span><span>{{.Cubic}} m³</span></div>{{end}}
        {{end}}
      </div>
    </section>
    {{end}}


    {{with .ProductReviews}}{{if .Total}}
    <section class="pd-reviews" id="pd-reviews" aria-label="{{$.T "product.reviewsTitle"}}">
      <h2 class="pd-section-title">{{$.T "product.reviewsTitle"}}</h2>
      <div class="pd-review-summary">
        <div class="pd-review-score">
          <strong>{{.Average}}</strong>
          <span class="pd-stars" aria-hidden="true">{{starRow .AvgValue}}</span>
          <span class="pd-review-count">{{$.TF "product.reviewsCount" .Total}}</span>
        </div>
        <ul class="pd-review-dist">
          {{range .Stars}}<li>
            <span class="pd-review-star">{{.Star}}{{$.T "product.reviewStarUnit"}}</span>
            <span class="pd-review-bar"><i style="width:{{.Percent}}%"></i></span>
            <span class="pd-review-num">{{.Count}}</span>
          </li>{{end}}
        </ul>
      </div>
      <ul class="pd-review-list">
        {{range .List}}<li class="pd-review-item">
          <div class="pd-review-head">
            <span class="pd-review-avatar" aria-hidden="true">{{initial .Author}}</span>
            <span class="pd-review-who">
              <span class="pd-review-name">{{if .Author}}{{.Author}}{{else}}{{$.T "product.reviewAnonymous"}}{{end}}</span>
              {{if .Country}}<span class="pd-review-country">{{.Country}}</span>{{end}}
            </span>
            <span class="pd-stars pd-stars-sm" aria-label="{{$.TF "product.reviewRatingAria" .Rating}}">{{starRow .StarsFloat}}</span>
          </div>
          {{if .Content}}<p class="pd-review-body">{{.Content}}</p>{{end}}
          <div class="pd-review-meta">
            {{if .Verified}}<span class="pd-review-verified">{{uiIcon "badge-check" "pd-review-vico"}}{{$.T "product.reviewVerified"}}</span>{{end}}
            {{if .Quantity}}<span>{{$.TF "product.reviewQty" .Quantity}}</span>{{end}}
            <span class="pd-review-date">{{.CreatedAt.Format "2006-01-02"}}</span>
          </div>
        </li>{{end}}
      </ul>
      {{if gt .Total (len .List)}}<p class="pd-review-more">{{$.TF "product.reviewsMore" .Total}}</p>{{end}}
    </section>
    {{end}}{{end}}

    {{if .ProductsRelated}}
    <section class="pd-recommend">
      <h2 class="pd-section-title">{{.T "product.otherRecommend"}}</h2>
      <div class="pd-rec-grid">{{range .ProductsRelated}}<a class="pd-rec-card" href="{{$.URL "/products"}}/{{.Slug}}">
        <span class="pd-rec-cover">{{if .CoverURL}}<img src="{{.CoverURL}}" alt="" loading="lazy">{{else}}<span class="pd-rec-fallback">{{initial .Title}}</span>{{end}}</span>
        <span class="pd-rec-name">{{.Title}}</span>
        {{if .PriceMin}}<span class="pd-rec-price">{{.Currency}}{{money .PriceMin}}{{if .PriceUnit}} / {{.PriceUnit}}{{end}}</span>{{end}}
        {{if .Moq}}<span class="pd-rec-moq">{{$.T "products.moqLabel"}}: {{.Moq}}</span>{{end}}
      </a>{{end}}</div>
    </section>
    {{end}}

    {{shareBar $}}
    {{if or .ProductPrev .ProductNext}}
    <nav class="dt-nav" aria-label="{{.T "detail.navAria"}}">
      {{if .ProductPrev}}<a class="dt-nav-item dt-prev" href="{{.URL "/products"}}/{{.ProductPrev.Slug}}"><small>{{.T "detail.prev"}}</small><span class="dt-t">{{.ProductPrev.Title}}</span></a>{{else}}<span class="dt-nav-item dt-empty"></span>{{end}}
      {{if .ProductNext}}<a class="dt-nav-item dt-next" href="{{.URL "/products"}}/{{.ProductNext.Slug}}"><small>{{.T "detail.next"}}</small><span class="dt-t">{{.ProductNext.Title}}</span></a>{{else}}<span class="dt-nav-item dt-empty"></span>{{end}}
    </nav>
    {{end}}
    <p class="pd-back"><a href="{{.URL "/products"}}">{{.T "products.back"}}</a></p>
  </div>
{{inquiryDialog $}}
</article>
{{end}}

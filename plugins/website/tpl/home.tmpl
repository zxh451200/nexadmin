{{define "content"}}
<section class="hero">
  <div class="hero-aura" aria-hidden="true"></div>
  <div class="hero-spot" aria-hidden="true"></div>
  <div class="hero-noise" aria-hidden="true"></div>
  <div class="container hero-in">
    <a class="hero-badge" href="{{.URL "/news"}}" data-reveal><span class="dot" aria-hidden="true"></span>{{.T "home.badge"}}<span class="badge-arrow" aria-hidden="true">→</span></a>
    <h1 class="hero-title" data-reveal>
      {{- range $i, $line := titleLines .HomeTitle}}
      {{- if $i}}<br>{{end}}<span class="title-line">{{$line}}</span>
      {{- end}}
    </h1>
    {{if .HomeSubtitle}}<p class="hero-sub" data-reveal>{{.HomeSubtitle}}</p>{{end}}
    <div class="hero-cta" data-reveal>
      {{if .HomeCTALabel}}<a class="btn btn-primary" href="{{.URL .HomeCTAHref}}">{{.HomeCTALabel}}</a>{{end}}
      <a class="btn btn-ghost" href="{{.Home}}#quickstart">{{.T "home.ctaSecondary"}}</a>
    </div>

    <div class="hero-visual" data-reveal>
      <div class="browser" role="img" aria-label="{{.TF "home.browserAria" .SiteName}}">
        <div class="browser-bar"><span class="bdot"></span><span class="bdot"></span><span class="bdot"></span><span class="browser-url">localhost:8080/dashboard</span></div>
        <div class="app">
          <aside class="app-side">
            <div class="app-side-brand"><span class="brand-mark sm" aria-hidden="true">{{initial .SiteName}}</span>{{.SiteName}}</div>
            <div class="app-search">{{.T "home.mock.search"}}<span class="kbd">Ctrl K</span></div>
            <nav class="app-menu">
              <span class="app-group">{{.T "home.mock.overview"}}</span>
              <a class="app-item active" href="#dashboard">{{.T "home.mock.dashboard"}}</a>
              <span class="app-group">{{.T "home.mock.system"}}</span>
              <a class="app-item" href="#users">{{.T "home.mock.users"}}</a>
              <a class="app-item" href="#roles">{{.T "home.mock.roles"}}</a>
              <a class="app-item" href="#plugins">{{.T "home.mock.plugins"}}</a>
              <span class="app-group">{{.T "home.mock.content"}}</span>
              <a class="app-item" href="#notice">{{.T "home.mock.notice"}}</a>
              <a class="app-item" href="#monitor">{{.T "home.mock.monitor"}}</a>
              <span class="app-group">{{.T "home.mock.tenant"}}</span>
              <a class="app-item" href="#tenant">{{.T "home.mock.tenantMgmt"}}</a>
              <a class="app-item" href="#portal">{{.T "home.mock.portal"}}</a>
            </nav>
          </aside>
          <div class="app-main">
            <div class="app-head"><h2>{{.T "home.mock.dashboard"}}</h2><span class="app-avatar" aria-hidden="true">A</span></div>
            <div class="stat-grid">
              <div class="stat"><span class="stat-label">{{.T "home.mock.usersTotal"}}</span><span class="stat-value">1,284</span><span class="stat-delta up">{{.T "home.mock.weekDelta"}}</span></div>
              <div class="stat"><span class="stat-label">{{.T "home.mock.online"}}</span><span class="stat-value">96</span><span class="stat-delta">{{.T "home.mock.live"}}</span></div>
              <div class="stat"><span class="stat-label">{{.T "home.mock.requests"}}</span><span class="stat-value">45.2k</span><span class="stat-delta">{{.T "home.mock.errorRate"}}</span></div>
              <div class="stat"><span class="stat-label">{{.T "home.mock.storage"}}</span><span class="stat-value">38%</span><span class="stat-bar" aria-hidden="true"><i style="width:38%"></i></span></div>
            </div>
            <div class="panel chart-panel">
              <div class="panel-head"><span>{{.T "home.mock.trend"}}</span><span class="legend"><i class="lg-a"></i>{{.T "home.mock.request"}}<i class="lg-b"></i>{{.T "home.mock.error"}}</span></div>
              <svg class="chart" viewBox="0 0 560 150" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="areaA" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#5E6AD2" stop-opacity=".28"/>
                    <stop offset="100%" stop-color="#5E6AD2" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path class="grid" d="M0 30h560M0 70h560M0 110h560"/>
                <path class="area" fill="url(#areaA)" d="M0 96C40 88 62 52 92 60s56 44 88 28 58-56 90-40 60 48 90 36 60-56 90-44 66 40 110 20V150H0z"/>
                <path class="line-a" pathLength="1" d="M0 96C40 88 62 52 92 60s56 44 88 28 58-56 90-40 60 48 90 36 60-56 90-44 66 40 110 20"/>
                <path class="line-b" pathLength="1" d="M0 128c40-2 62-8 92-6s56 10 88 4 58-12 90-8 60 12 90 8 60-10 90-6 66 8 110 2"/>
              </svg>
            </div>
            <div class="panel table-panel">
              <div class="panel-head"><span>{{.T "home.mock.recent"}}</span><a class="panel-more" href="#login-logs">{{.T "home.mock.all"}}</a></div>
              <div class="row"><span class="pill ok">{{.T "home.mock.password"}}</span><span class="row-main">admin · 10.0.8.21</span><span class="row-time">{{.TF "home.mock.minutesAgo" 1}}</span></div>
              <div class="row"><span class="pill ok">GitHub</span><span class="row-main">zxh · 10.0.6.4</span><span class="row-time">{{.TF "home.mock.minutesAgo" 3}}</span></div>
              <div class="row"><span class="pill bad">{{.T "home.mock.sms"}}</span><span class="row-main">138****1234 · {{.T "home.mock.codeExpired"}}</span><span class="row-time">{{.TF "home.mock.minutesAgo" 8}}</span></div>
            </div>
          </div>
        </div>
      </div>
      <p class="visual-caption">{{.T "home.mock.caption"}}</p>
    </div>
  </div>
</section>

<section class="tech">
  <div class="container" data-reveal>
    <p class="tech-title">{{.T "home.tech.title"}}</p>
    <ul class="tech-list">
      <li>Go</li><li>Gin</li><li>GORM</li><li>React</li><li>TypeScript</li><li>shadcn/ui</li>
      <li>MySQL</li><li>MariaDB</li><li>PostgreSQL</li><li>Redis / Valkey</li>
    </ul>
  </div>
</section>

{{if .Features}}
<section class="section" id="features">
  <div class="container">
    <header class="section-head" data-reveal>
      <div class="section-copy">
        <p class="fig">{{.T "home.features.fig"}}</p>
        <h2>{{.T "home.features.title"}}</h2>
        <p class="section-sub">{{.T "home.features.sub"}}</p>
      </div>
    </header>
    <div class="feature-grid">
      {{range .Features}}
      <article class="feature" data-reveal>
        <span class="feature-icon">{{icon .Icon}}</span>
        <h3>{{.Title}}</h3>
        <p>{{.Description}}</p>
      </article>
      {{end}}
    </div>
  </div>
</section>
{{end}}

<section class="section" id="showcase">
  <div class="container">
    <header class="section-head" data-reveal>
      <div class="section-copy">
        <p class="fig">{{.T "home.showcase.fig"}}</p>
        <h2>{{.T "home.showcase.title"}}</h2>
        <p class="section-sub">{{.T "home.showcase.sub"}}</p>
      </div>
    </header>
    <div class="tabs" role="tablist" aria-label="{{.T "home.showcase.tabsAria"}}" data-tabs>
      <button class="tab" type="button" role="tab" id="tab-perm" aria-controls="panel-perm" aria-selected="true">{{.T "home.showcase.tabPerm"}}</button>
      <button class="tab" type="button" role="tab" id="tab-open" aria-controls="panel-open" aria-selected="false" tabindex="-1">{{.T "home.showcase.tabOpen"}}</button>
      <button class="tab" type="button" role="tab" id="tab-obs" aria-controls="panel-obs" aria-selected="false" tabindex="-1">{{.T "home.showcase.tabObs"}}</button>
    </div>
    <div class="showcase-body" data-reveal>
      <div class="showcase-panel" role="tabpanel" id="panel-perm" aria-labelledby="tab-perm">
        <div class="mock">
          <div class="mock-head"><span>{{.T "home.perm.head"}}</span><span class="mock-chip">{{.T "home.perm.chip"}}</span></div>
          <div class="mock-table">
            <div class="mock-tr mock-th"><span>{{.T "home.perm.role"}}</span><span>{{.T "home.perm.codes"}}</span><span>{{.T "home.perm.scope"}}</span></div>
            <div class="mock-tr"><span>{{.T "home.perm.super"}}</span><span class="mono">*:*</span><span class="scope scope-all">{{.T "home.perm.all"}}</span></div>
            <div class="mock-tr"><span>{{.T "home.perm.ops"}}</span><span class="mono">user:list · user:edit</span><span class="scope">{{.T "home.perm.dept"}}</span></div>
            <div class="mock-tr"><span>{{.T "home.perm.auditor"}}</span><span class="mono">audit:list</span><span class="scope">{{.T "home.perm.self"}}</span></div>
          </div>
          <p class="mock-note">{{.T "home.perm.note"}}</p>
        </div>
      </div>
      <div class="showcase-panel" role="tabpanel" id="panel-open" aria-labelledby="tab-open" hidden>
        <div class="mock">
          <div class="mock-head"><span>{{.T "home.open.head"}}</span><span class="mock-chip">OpenAPI · Webhook · MCP</span></div>
          <div class="mock-code">
            <div><span class="k">POST</span><span class="mono">/api/v1/profile/tokens</span><span class="ok">201</span><span class="dim">{{.T "home.open.token"}}</span></div>
            <div><span class="k">POST</span><span class="mono">/api/v1/openapi/webhooks</span><span class="ok">202</span><span class="dim">{{.T "home.open.hmac"}}</span></div>
            <div><span class="k">GET</span><span class="mono">/api/v1/openapi/events</span><span class="ok">200</span><span class="dim">{{.T "home.open.events"}}</span></div>
            <div><span class="k">GET</span><span class="mono">/api/v1/openapi.json</span><span class="ok">200</span><span class="dim">{{.T "home.open.docs"}}</span></div>
          </div>
          <p class="mock-note">{{.T "home.open.note"}}</p>
        </div>
      </div>
      <div class="showcase-panel" role="tabpanel" id="panel-obs" aria-labelledby="tab-obs" hidden>
        <div class="mock">
          <div class="mock-head"><span>{{.T "home.obs.head"}}</span><span class="mock-chip">/metrics · Prometheus</span></div>
          <div class="svc-list">
            <div class="svc"><span class="dot" aria-hidden="true"></span><span>{{.T "home.obs.gateway"}}</span><span class="svc-lat">42 ms</span>
              <svg class="spark" viewBox="0 0 140 26" aria-hidden="true"><path d="M0 19L12 15L24 17L36 10L48 13L60 7L72 11L84 5L96 9L108 4L120 8L132 6L140 3"/></svg>
            </div>
            <div class="svc"><span class="dot" aria-hidden="true"></span><span>{{.T "home.obs.db"}}</span><span class="svc-lat">8 ms</span>
              <svg class="spark" viewBox="0 0 140 26" aria-hidden="true"><path d="M0 12L12 13L24 11L36 12L48 9L60 10L72 8L84 11L96 9L108 10L120 7L132 8L140 6"/></svg>
            </div>
            <div class="svc"><span class="dot" aria-hidden="true"></span><span>{{.T "home.obs.cache"}}</span><span class="svc-lat">1 ms</span>
              <svg class="spark" viewBox="0 0 140 26" aria-hidden="true"><path d="M0 8L12 7L24 8L36 6L48 7L60 5L72 6L84 5L96 6L108 4L120 5L132 4L140 5"/></svg>
            </div>
            <div class="svc"><span class="dot warn" aria-hidden="true"></span><span>{{.T "home.obs.fe"}}</span><span class="svc-lat">0.4%</span>
              <svg class="spark" viewBox="0 0 140 26" aria-hidden="true"><path d="M0 18L12 20L24 14L36 17L48 12L60 16L72 10L84 15L96 11L108 14L120 9L132 12L140 8"/></svg>
            </div>
          </div>
          <p class="mock-note">{{.T "home.obs.note"}}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="product">
  <div class="container">
    <header class="section-head" data-reveal>
      <div class="section-copy">
        <p class="fig">{{.T "home.product.fig"}}</p>
        <h2>{{.T "home.product.title"}}</h2>
        <p class="section-sub">{{.T "home.product.sub"}}</p>
      </div>
    </header>
    <figure class="shot-frame" data-reveal>
      <img src="/website-assets/market/dashboard.jpg" alt="{{.TF "home.product.alt" .SiteName}}" loading="lazy">
      <figcaption>{{.T "home.product.caption"}}</figcaption>
    </figure>
  </div>
</section>

<section class="section" id="integrations">
  <div class="container">
    <header class="section-head" data-reveal>
      <div class="section-copy">
        <p class="fig">{{.T "home.intg.fig"}}</p>
        <h2>{{.T "home.intg.title"}}</h2>
        <p class="section-sub">{{.T "home.intg.sub"}}</p>
      </div>
      <a class="section-more" href="{{.Home}}#features">{{.T "home.intg.more"}}</a>
    </header>
    <ul class="intg-grid" data-reveal>
      <li><span class="intg-mark" aria-hidden="true">{{icon "code"}}</span><span class="intg-name">{{.T "home.intg.github"}}</span><span class="intg-kind">{{.T "home.intg.kindOauth"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "users"}}</span><span class="intg-name">{{.T "home.intg.wecom"}}</span><span class="intg-kind">{{.T "home.intg.kindScan"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "bell"}}</span><span class="intg-name">{{.T "home.intg.dingtalk"}}</span><span class="intg-kind">{{.T "home.intg.kindScan"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "zap"}}</span><span class="intg-name">{{.T "home.intg.feishu"}}</span><span class="intg-kind">{{.T "home.intg.kindScan"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "box"}}</span><span class="intg-name">{{.T "home.intg.s3"}}</span><span class="intg-kind">{{.T "home.intg.kindUpload"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "chart"}}</span><span class="intg-name">{{.T "home.intg.prometheus"}}</span><span class="intg-kind">{{.T "home.intg.kindMetrics"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "key"}}</span><span class="intg-name">{{.T "home.intg.oidc"}}</span><span class="intg-kind">{{.T "home.intg.kindIdp"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "plug"}}</span><span class="intg-name">{{.T "home.intg.webhook"}}</span><span class="intg-kind">{{.T "home.intg.kindEvents"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "terminal"}}</span><span class="intg-name">{{.T "home.intg.mcp"}}</span><span class="intg-kind">{{.T "home.intg.kindTool"}}</span></li>
    </ul>
  </div>
</section>

{{if and .MarketEnabled .FeaturedPlugins}}
<section class="section" id="market">
  <div class="container">
    <header class="section-head" data-reveal>
      <div class="section-copy">
        <p class="fig">{{.T "home.market.fig"}}</p>
        <h2>{{.T "home.market.title"}}</h2>
        <p class="section-sub">{{.T "home.market.sub"}}</p>
      </div>
      <a class="section-more" href="{{.URL "/plugins"}}">{{.T "home.market.more"}}</a>
    </header>
    <div class="plugin-grid">
      {{range .FeaturedPlugins}}
      <article class="plugin-card" data-reveal>
        {{if .Cover}}<img class="plugin-cover" src="{{.Cover}}" alt="" loading="lazy">{{else}}<div class="plugin-cover plugin-cover-fallback cat-{{.Category}}" aria-hidden="true"><span>{{.Initial}}</span></div>{{end}}
        <header class="plugin-card-head">
          <span class="plugin-icon" aria-hidden="true">{{.Initial}}</span>
          <div class="plugin-title">
            <h3><a href="{{$.URL .DetailURL}}">{{.Name}}</a></h3>
            <span class="plugin-id">{{.ID}} · v{{.Version}}</span>
          </div>
          <span class="pill {{if .Pro}}pro{{end}}">{{if .Pro}}{{$.T "market.pro"}}{{else}}{{$.T "market.free"}}{{end}}</span>
        </header>
        <p class="plugin-desc">{{.Description}}</p>
        <div class="plugin-stats-line">
          {{if .RatingCount}}<span class="plugin-rating">★ {{.RatingAvg}} <small>({{.RatingCount}})</small></span>{{end}}
          {{if .Downloads}}<span>{{$.TF "market.downloads" .DownloadsText}}</span>{{end}}
        </div>
        <footer class="plugin-card-foot">
          <span class="plugin-cat">{{.CategoryLabel}}</span>
          <a class="plugin-link" href="{{$.URL .DetailURL}}" aria-label="{{$.TF "market.detailAria" .Name}}">{{$.T "market.detail"}}</a>
        </footer>
      </article>
      {{end}}
    </div>
  </div>
</section>
{{end}}

{{if .Posts}}
<section class="section section-alt" id="news">
  <div class="container">
    <header class="section-head" data-reveal>
      <div class="section-copy">
        <p class="fig">{{.T "home.news.fig"}}</p>
        <h2>{{.T "home.news.title"}}</h2>
      </div>
      <a class="section-more" href="{{.URL "/news"}}">{{.T "home.news.more"}}</a>
    </header>
    <div class="post-grid">
      {{range .Posts}}
      <a class="post-card" href="{{$.URL "/news"}}/{{.Slug}}" data-reveal>
        {{if .CoverURL}}<img class="post-cover" src="{{.CoverURL}}" alt="" loading="lazy">{{end}}
        <time class="post-date">{{if .PublishedAt}}{{fmtDate $.Lang .PublishedAt}}{{else}}{{fmtDate $.Lang .UpdatedAt}}{{end}}</time>
        <h3>{{.Title}}</h3>
        {{if .Summary}}<p>{{.Summary}}</p>{{end}}
      </a>
      {{end}}
    </div>
  </div>
</section>
{{end}}

<section class="section" id="quickstart">
  <div class="container qs-grid">
    <div class="qs-copy" data-reveal>
      <p class="fig">{{.T "home.qs.fig"}}</p>
      <h2>{{.T "home.qs.title"}}</h2>
      <p class="section-sub">{{.T "home.qs.sub"}}</p>
      <ol class="qs-steps">
        <li><b>{{.T "home.qs.build"}}</b>{{.T "home.qs.buildText"}}</li>
        <li><b>{{.T "home.qs.start"}}</b>{{.T "home.qs.startText"}}</li>
        <li><b>{{.T "home.qs.open"}} <code>/setup</code></b>{{.T "home.qs.setupText"}}</li>
      </ol>
      <p class="qs-note">{{.T "home.qs.notePre"}}<code>go run ./cmd/server</code>{{.T "home.qs.noteMid"}}<code>cd web &amp;&amp; npm run dev</code>{{.T "home.qs.notePost"}}</p>
    </div>
    <div class="terminal" data-reveal role="img" aria-label="{{.T "home.qs.aria"}}">
      <div class="term-bar"><span class="bdot"></span><span class="bdot"></span><span class="bdot"></span><span class="term-title">sh — nexadmin</span></div>
      <pre class="term-body"><code><span class="tl"><span class="p">$</span> sh scripts/build.sh</span>
<span class="tl"><span class="c">web   npm ci + npm run build</span></span>
<span class="tl"><span class="c">build go build -tags embedweb</span></span>
<span class="tl"><span class="o">✓ bin/nexadmin-server</span></span>
<span class="tl"><span class="p">$</span> ./bin/nexadmin-server start</span>
<span class="tl"><span class="o">{{.T "home.term.setup"}}  http://localhost:8080/setup</span></span>
<span class="tl"><span class="o">{{.T "home.term.token"}}  8f3a-…{{.T "home.term.tokenNote"}}</span></span>
<span class="tl"><span class="p">$</span> <span class="c">{{.T "home.term.hint"}}</span><span class="caret" aria-hidden="true"></span></span></code></pre>
    </div>
  </div>
</section>

<section class="quote">
  <div class="container quote-in" data-reveal>
    <p class="fig">{{.T "home.quote.fig"}}</p>
    <blockquote>{{.T "home.quote.body"}}</blockquote>
    <p class="quote-by">{{.T "home.quote.by"}}</p>
  </div>
</section>

<section class="cta">
  <div class="container cta-in" data-reveal>
    <h2>{{.T "home.cta.title"}}</h2>
    <p>{{.T "home.cta.sub"}}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="{{.Home}}#quickstart">{{.T "home.cta.primary"}}</a>
      <a class="btn btn-ghost" href="{{.URL "/p/about"}}">{{.T "home.cta.secondary"}}</a>
    </div>
  </div>
</section>
{{end}}

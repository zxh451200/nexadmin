{{define "content"}}
{{/* 首页 v3：linear.app 式编辑版式，但按「信息优先」重排——
     1) 首屏：定位句 + 真实界面，先回答「它是什么」；
     2) 陈述 + Fig 0.1~0.3 + 设计准则引语合成一个分区；
     3) 两块产品界面（核心平台 / 扩展体系）；
     4) 出厂能力与集成合并成一个分区；
     5) 插件市场 → 上手（含 FAQ）→ 更新 → 收尾 CTA。
     文案全部走 i18n，界面图沿用后台真实截图（深浅两套随主题切换）。 */}}
<div class="hp">

  <section class="hp-hero">
    <div class="container hp-hero-in">
      <div class="hp-hero-copy" data-reveal>
        <h1 class="hp-hero-title">
          {{- range $i, $line := titleLines .HomeTitle}}
          {{- if $i}}<br>{{end}}<span class="hp-title-line">{{$line}}</span>
          {{- end}}
        </h1>
        {{if ne (.T "home.heroLede") ""}}
        <p class="hp-hero-lede">
          {{- range $i, $line := titleLines (.T "home.heroLede")}}
          {{- if $i}}<br>{{end}}{{$line}}
          {{- end}}
        </p>
        {{end}}
        {{if .HomeSubtitle}}<p class="hp-hero-sub">{{.HomeSubtitle}}</p>{{end}}
        <div class="hp-hero-actions">
          {{if .HomeCTALabel}}<a class="btn btn-primary" href="{{.URL .HomeCTAHref}}">{{.HomeCTALabel}}</a>{{end}}
          <a class="hp-hero-link" href="#quickstart">{{.T "home.heroQuickstart"}}<span aria-hidden="true">→</span></a>
        </div>
        {{if .MarketEnabled}}
        <p class="hp-hero-new">
          <a href="{{.URL "/plugins"}}"><span class="hp-new-tag">{{.T "home.new.tag"}}</span>{{.T "home.new.text"}}<span class="hp-new-arrow" aria-hidden="true">→</span></a>
        </p>
        {{else if .Posts}}
        <p class="hp-hero-new">
          <a href="{{.URL "/news"}}"><span class="hp-new-tag">{{.T "home.new.tag"}}</span>{{.T "home.badge"}}<span class="hp-new-arrow" aria-hidden="true">→</span></a>
        </p>
        {{end}}
      </div>

      <div class="hp-hero-stage" data-reveal>
        <figure class="hp-window hp-demo" data-product-demo data-readonly-status="{{.T "home.demo.status.readonly"}}">
          <div class="hp-demo-toolbar">
            <div class="hp-demo-tabs" role="tablist" aria-label="{{.T "home.demo.tabsAria"}}">
              <button id="demo-tab-dashboard" type="button" role="tab" aria-selected="true" aria-controls="demo-panel-dashboard" data-demo-tab="dashboard" data-demo-tab-status="{{.T "home.demo.status.dashboard"}}">{{.T "home.demo.tab.dashboard"}}</button>
              <button id="demo-tab-users" type="button" role="tab" aria-selected="false" aria-controls="demo-panel-users" data-demo-tab="users" data-demo-tab-status="{{.T "home.demo.status.users"}}" tabindex="-1">{{.T "home.demo.tab.users"}}</button>
              <button id="demo-tab-plugins" type="button" role="tab" aria-selected="false" aria-controls="demo-panel-plugins" data-demo-tab="plugins" data-demo-tab-status="{{.T "home.demo.status.plugins"}}" tabindex="-1">{{.T "home.demo.tab.plugins"}}</button>
            </div>
            <div class="hp-demo-controls">
              <span class="hp-demo-hint">{{.T "home.demo.hint"}}</span>
              <details class="hp-demo-mode" data-demo-mode>
                <summary aria-label="{{.T "home.demo.modeAria"}}" aria-haspopup="listbox">{{uiIcon "shield"}}<span data-demo-mode-current>{{.T "home.demo.mode.interactive"}}</span>{{uiIcon "chevron-down"}}</summary>
                <div class="hp-demo-mode-menu" role="listbox" aria-label="{{.T "home.demo.modeAria"}}">
                  <button type="button" role="option" aria-selected="true" data-demo-mode-value="interactive" data-demo-mode-status="{{.T "home.demo.modeStatus.interactive"}}"><span>{{.T "home.demo.mode.interactive"}}</span><small>{{.T "home.demo.mode.interactiveHint"}}</small></button>
                  <button type="button" role="option" aria-selected="false" data-demo-mode-value="confirm" data-demo-mode-status="{{.T "home.demo.modeStatus.confirm"}}"><span>{{.T "home.demo.mode.confirm"}}</span><small>{{.T "home.demo.mode.confirmHint"}}</small></button>
                  <button type="button" role="option" aria-selected="false" data-demo-mode-value="readonly" data-demo-mode-status="{{.T "home.demo.modeStatus.readonly"}}"><span>{{.T "home.demo.mode.readonly"}}</span><small>{{.T "home.demo.mode.readonlyHint"}}</small></button>
                </div>
              </details>
              <button class="hp-demo-icon-btn" type="button" data-demo-search-toggle aria-expanded="false" aria-controls="demo-search" aria-label="{{.T "home.demo.searchAria"}}" title="{{.T "home.demo.searchAria"}}">{{uiIcon "search"}}</button>
              <button class="hp-demo-reset" type="button" data-demo-reset data-status="{{.T "home.demo.status.reset"}}">{{.T "home.demo.reset"}}</button>
            </div>
          </div>
          <div class="hp-demo-stage">
            <div class="hp-demo-screen" id="demo-panel-dashboard" role="tabpanel" aria-labelledby="demo-tab-dashboard" data-demo-panel="dashboard">
              <img class="shot-dark" src="{{if .HeroImageDarkURL}}{{.HeroImageDarkURL}}{{else if .HeroImageURL}}{{.HeroImageURL}}{{else}}/website-assets/market/dashboard-dark.jpg?v={{assetV "market/dashboard-dark.jpg"}}{{end}}" alt="{{.TF "home.heroShotAlt" .SiteName}}" width="1440" height="900" decoding="async" fetchpriority="high">
              <img class="shot-light" src="{{if .HeroImageURL}}{{.HeroImageURL}}{{else}}/website-assets/market/dashboard-light.jpg?v={{assetV "market/dashboard-light.jpg"}}{{end}}" alt="{{.TF "home.heroShotAlt" .SiteName}}" width="1440" height="900" decoding="async" fetchpriority="high">
              <button class="hp-hotspot hp-hotspot--right" type="button" style="--x:10.8%;--y:36.5%" data-demo-action="users" aria-label="{{.T "home.demo.action.users"}}">{{uiIcon "users"}}<span class="hp-hotspot-label">{{.T "home.demo.action.users"}}</span></button>
              <button class="hp-hotspot hp-hotspot--left" type="button" style="--x:91.5%;--y:13.7%" data-demo-action="layout" data-status="{{.T "home.demo.status.layout"}}" aria-label="{{.T "home.demo.action.layout"}}">{{uiIcon "layout"}}<span class="hp-hotspot-label">{{.T "home.demo.action.layout"}}</span></button>
            </div>
            <div class="hp-demo-screen" id="demo-panel-users" role="tabpanel" aria-labelledby="demo-tab-users" data-demo-panel="users" hidden>
              <img class="shot-dark" src="/website-assets/market/user-dark.jpg?v={{assetV "market/user-dark.jpg"}}" alt="{{.T "home.pillarShot.userAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
              <img class="shot-light" src="/website-assets/market/user-light.jpg?v={{assetV "market/user-light.jpg"}}" alt="{{.T "home.pillarShot.userAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
              <button class="hp-hotspot hp-hotspot--right" type="button" style="--x:22%;--y:26.2%" data-demo-action="create" aria-label="{{.T "home.demo.action.create"}}">{{uiIcon "user-plus"}}<span class="hp-hotspot-label">{{.T "home.demo.action.create"}}</span></button>
              <button class="hp-hotspot hp-hotspot--right" type="button" style="--x:74.4%;--y:51.2%" data-demo-action="toggle" aria-pressed="false" data-label-on="{{.T "home.demo.action.enable"}}" data-label-off="{{.T "home.demo.action.disable"}}" data-status-on="{{.T "home.demo.status.enabled"}}" data-status-off="{{.T "home.demo.status.disabled"}}" aria-label="{{.T "home.demo.action.disable"}}">{{uiIcon "power"}}<span class="hp-hotspot-label">{{.T "home.demo.action.disable"}}</span></button>
            </div>
            <div class="hp-demo-screen" id="demo-panel-plugins" role="tabpanel" aria-labelledby="demo-tab-plugins" data-demo-panel="plugins" hidden>
              <img class="shot-dark" src="/website-assets/market/pluginmarket-dark.jpg?v={{assetV "market/pluginmarket-dark.jpg"}}" alt="{{.T "home.pillarShot.marketAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
              <img class="shot-light" src="/website-assets/market/pluginmarket-light.jpg?v={{assetV "market/pluginmarket-light.jpg"}}" alt="{{.T "home.pillarShot.marketAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
              <button class="hp-hotspot hp-hotspot--right" type="button" style="--x:16%;--y:40.2%" data-demo-action="license" aria-pressed="false" data-label-on="{{.T "home.demo.action.licensed"}}" data-label-off="{{.T "home.demo.action.license"}}" data-status-on="{{.T "home.demo.status.licensed"}}" aria-label="{{.T "home.demo.action.license"}}">{{uiIcon "plug"}}<span class="hp-hotspot-label">{{.T "home.demo.action.license"}}</span></button>
            </div>
            <div class="hp-demo-search" id="demo-search" role="search" hidden>
              <label class="hp-demo-search-field">
                <span class="sr-only">{{.T "home.demo.searchAria"}}</span>
                {{uiIcon "search"}}
                <input type="search" data-demo-search-input placeholder="{{.T "home.demo.searchPlaceholder"}}" autocomplete="off" aria-controls="demo-search-results">
              </label>
              <ul id="demo-search-results" data-demo-search-results>
                <li><button type="button" data-demo-search-result="dashboard"><span>{{.T "home.demo.tab.dashboard"}}</span><small>{{.T "home.demo.search.dashboardDesc"}}</small></button></li>
                <li><button type="button" data-demo-search-result="users"><span>{{.T "home.demo.tab.users"}}</span><small>{{.T "home.demo.search.usersDesc"}}</small></button></li>
                <li><button type="button" data-demo-search-result="plugins"><span>{{.T "home.demo.tab.plugins"}}</span><small>{{.T "home.demo.search.pluginsDesc"}}</small></button></li>
              </ul>
              <p class="hp-demo-search-empty" data-demo-search-empty hidden>{{.T "home.demo.searchEmpty"}}</p>
            </div>
          </div>
          <div class="hp-demo-confirm" data-demo-confirm role="alert" hidden>
            <span>{{.T "home.demo.confirm"}}</span>
            <div>
              <button type="button" data-demo-confirm-no>{{.T "home.demo.confirmNo"}}</button>
              <button type="button" data-demo-confirm-yes>{{.T "home.demo.confirmYes"}}</button>
            </div>
          </div>
          <figcaption class="hp-hero-caption hp-demo-caption">
            <div class="hp-demo-caption-status"><span class="hp-dot" aria-hidden="true"></span><span data-demo-status role="status" aria-live="polite">{{.T "home.demo.status.dashboard"}}</span></div>
            <div class="hp-demo-quick" role="group" aria-label="{{.T "home.demo.actionsAria"}}">
              <button class="hp-demo-quick-btn" type="button" data-demo-quick-actions="dashboard" data-demo-action="users">{{.T "home.demo.action.users"}}</button>
              <button class="hp-demo-quick-btn" type="button" data-demo-quick-actions="dashboard" data-demo-action="plugins">{{.T "home.demo.action.plugins"}}</button>
              <button class="hp-demo-quick-btn" type="button" data-demo-quick-actions="dashboard" data-demo-action="layout" data-status="{{.T "home.demo.status.layout"}}">{{.T "home.demo.action.layout"}}</button>
              <button class="hp-demo-quick-btn" type="button" data-demo-quick-actions="users" data-demo-action="create" hidden>{{.T "home.demo.action.create"}}</button>
              <button class="hp-demo-quick-btn" type="button" data-demo-quick-actions="users" data-demo-action="toggle" data-label-on="{{.T "home.demo.action.enable"}}" data-label-off="{{.T "home.demo.action.disable"}}" data-status-on="{{.T "home.demo.status.enabled"}}" data-status-off="{{.T "home.demo.status.disabled"}}" aria-pressed="false" hidden>{{.T "home.demo.action.disable"}}</button>
              <button class="hp-demo-quick-btn" type="button" data-demo-quick-actions="plugins" data-demo-action="license" data-label-on="{{.T "home.demo.action.licensed"}}" data-label-off="{{.T "home.demo.action.license"}}" data-status-on="{{.T "home.demo.status.licensed"}}" aria-pressed="false" hidden>{{.T "home.demo.action.license"}}</button>
            </div>
          </figcaption>
        </figure>
        <dialog class="hp-demo-dialog" id="demo-user-dialog" aria-labelledby="demo-user-title">
          <form data-demo-user-form data-status="{{.T "home.demo.status.created"}}">
            <header>
              <div>
                <p class="hp-kicker">{{.T "home.demo.userKicker"}}</p>
                <h3 id="demo-user-title">{{.T "home.demo.userTitle"}}</h3>
              </div>
              <button class="hp-demo-icon-btn" type="button" data-demo-dialog-close aria-label="{{.T "home.demo.userCancel"}}">{{uiIcon "close"}}</button>
            </header>
            <label>{{.T "home.demo.userName"}}<input name="name" required maxlength="40" autocomplete="off"></label>
            <label>{{.T "home.demo.userAccount"}}<input name="account" required maxlength="40" autocomplete="off"></label>
            <label>{{.T "home.demo.userRole"}}
              <select name="role">
                <option value="editor">{{.T "home.demo.userRoleEditor"}}</option>
                <option value="auditor">{{.T "home.demo.userRoleAuditor"}}</option>
              </select>
            </label>
            <footer>
              <button type="button" data-demo-dialog-close>{{.T "home.demo.userCancel"}}</button>
              <button type="submit" class="btn btn-primary btn-sm">{{.T "home.demo.userSubmit"}}</button>
            </footer>
          </form>
        </dialog>
      </div>

    </div>
  </section>

  <section class="hp-principles" id="features">
    <div class="container">
      <p class="hp-statement-text" data-reveal><span class="hp-statement-lead">{{.T "home.statement.strong"}}</span> <span class="hp-statement-rest">{{.T "home.statement.rest"}}</span></p>
    </div>

    <div class="container">
      <div class="hp-principles-grid">
        <article class="hp-principle" data-reveal>
          <p class="hp-fig"><span>Fig 0.1</span></p>
          <div class="hp-art" aria-hidden="true">
            <svg viewBox="0 0 220 220" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
              <path d="M110 42 178 76 110 110 42 76Z"></path>
              <path d="M42 76v20l68 34 68-34V76"></path>
              <path d="M42 96v20l68 34 68-34V96"></path>
              <path d="M42 116v20l68 34 68-34v-20"></path>
              <path d="M110 110v20" opacity=".5"></path>
              <path d="M76 93v20M144 93v20" opacity=".5"></path>
            </svg>
          </div>
          <h3>{{.T "home.principle1.title"}}</h3>
          <p>{{.T "home.principle1.desc"}}</p>
        </article>

        <article class="hp-principle" data-reveal>
          <p class="hp-fig"><span>Fig 0.2</span></p>
          <div class="hp-art" aria-hidden="true">
            <svg viewBox="0 0 220 220" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
              <path d="M110 26l34 19v38l-34 19-34-19V45Z"></path>
              <path d="M110 26v38M76 45l34 19 34-19"></path>
              <path d="M64 108l32 18v36l-32 18-32-18v-36Z"></path>
              <path d="M64 108v36M32 126l32 18 32-18"></path>
              <path d="M156 108l32 18v36l-32 18-32-18v-36Z"></path>
              <path d="M156 108v36M124 126l32 18 32-18"></path>
              <path d="M105 84l-9 24M115 84l9 24" opacity=".45"></path>
            </svg>
          </div>
          <h3>{{.T "home.principle2.title"}}</h3>
          <p>{{.T "home.principle2.desc"}}</p>
        </article>

        <article class="hp-principle" data-reveal>
          <p class="hp-fig"><span>Fig 0.3</span></p>
          <div class="hp-art" aria-hidden="true">
            <svg viewBox="0 0 220 220" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
              <path d="M32 158l92-26 64 16-92 26Z"></path>
              <path d="M40 140l92-26 64 16-92 26Z" opacity=".78"></path>
              <path d="M48 122l92-26 64 16-92 26Z" opacity=".58"></path>
              <path d="M56 104l92-26 64 16-92 26Z" opacity=".4"></path>
              <path d="M64 86l92-26 64 16-92 26Z" opacity=".24"></path>
              <path d="M32 158v12l92 26 64-18v-12" opacity=".5"></path>
            </svg>
          </div>
          <h3>{{.T "home.principle3.title"}}</h3>
          <p>{{.T "home.principle3.desc"}}</p>
        </article>
      </div>
    </div>

  </section>

  <section class="hp-show" id="platform">
    <div class="container">
      <div class="hp-show-head">
        <div class="hp-show-title" data-reveal>
          <p class="hp-kicker">{{.T "home.platform.kicker"}}</p>
          <h2 class="hp-h2">{{range $i, $line := titleLines (.T "home.editorial.platform.title")}}{{if $i}}<br>{{end}}<span class="hp-h2-line{{if $i}} dim{{end}}">{{$line}}</span>{{end}}</h2>
        </div>
        <div class="hp-show-aside" data-reveal>
          <p class="hp-lead">{{.T "home.editorial.platform.sub"}}</p>
          <a class="hp-more" href="{{.URL "/docs/features"}}">{{.T "home.editorial.platform.link"}}<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <figure class="hp-show-shot" data-reveal>
        <img class="shot-dark" src="/website-assets/market/user-dark.jpg?v={{assetV "market/user-dark.jpg"}}" alt="{{.T "home.pillarShot.userAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
        <img class="shot-light" src="/website-assets/market/user-light.jpg?v={{assetV "market/user-light.jpg"}}" alt="{{.T "home.pillarShot.userAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
      </figure>
      <ul class="hp-tags" data-reveal>
        <li>{{.T "home.platform.f1"}}</li>
        <li>{{.T "home.platform.f2"}}</li>
        <li>{{.T "home.platform.f3"}}</li>
        <li>{{.T "home.platform.f4"}}</li>
        <li class="hp-tags-note">{{.T "home.pillarShot.userNote"}}</li>
      </ul>
    </div>
  </section>

  {{/* 源码交付实证：用真实目录树把「框架区 / 用户区分离」从口号变成看得见的结构。
       目录与 AGENTS.md / 二次开发指南一致；框架区标 dim、用户区高亮，升级边界一眼可见。 */}}
  <section class="hp-show hp-source" id="source">
    <div class="container hp-source-in">
      <div class="hp-source-copy" data-reveal>
        <p class="hp-kicker">{{.T "home.source.kicker"}}</p>
        <h2 class="hp-h2 hp-h2-sm">{{range $i, $line := titleLines (.T "home.source.title")}}{{if $i}}<br>{{end}}<span class="hp-h2-line{{if $i}} dim{{end}}">{{$line}}</span>{{end}}</h2>
        <p class="hp-lead">{{.T "home.source.sub"}}</p>
        <p class="hp-source-key"><span class="hp-source-swatch framework"></span>{{.T "home.source.legendFw"}}<span class="hp-source-swatch yours"></span>{{.T "home.source.legendYours"}}</p>
        <a class="hp-more" href="{{.URL "/docs/二次开发指南"}}">{{.T "home.source.link"}}<span aria-hidden="true">→</span></a>
      </div>
      <div class="hp-tree" data-reveal role="img" aria-label="{{.T "home.source.aria"}}">
        <div class="hp-tree-bar"><span class="bdot"></span><span class="bdot"></span><span class="bdot"></span><span class="hp-tree-title">~/myapp</span></div>
        <pre class="hp-tree-body"><code><span class="tr-root">myapp/</span>
├── <span class="tr-fw">core/ modules/ pkg/ cmd/</span>
├── <span class="tr-fw">web/src/framework/</span>       <span class="tr-cmt">{{.T "home.source.tree.web"}}</span>
├── <span class="tr-fw">migrations/framework/</span>
├── <span class="tr-fw">docs/ deploy/ scripts/</span>
├── <span class="tr-fw">config/default.yaml</span>
├── <span class="tr-you">internal/ plugins/</span>     <span class="tr-cmt tr-hl">{{.T "home.source.tree.business"}}</span>
├── <span class="tr-you">web/src/pages/ web/src/plugins/</span> <span class="tr-cmt tr-hl">{{.T "home.source.tree.pages"}}</span>
├── <span class="tr-you">migrations/business/</span>   <span class="tr-cmt tr-hl">{{.T "home.source.tree.migrations"}}</span>
└── <span class="tr-you">config/config.yaml data/</span> <span class="tr-cmt tr-hl">{{.T "home.source.tree.config"}}</span></code></pre>
      </div>
    </div>
  </section>

  <section class="hp-show" id="extension">
    <div class="container">
      <div class="hp-show-head">
        <div class="hp-show-title" data-reveal>
          <p class="hp-kicker">{{.T "home.extension.kicker"}}</p>
          <h2 class="hp-h2">{{range $i, $line := titleLines (.T "home.editorial.extension.title")}}{{if $i}}<br>{{end}}<span class="hp-h2-line{{if $i}} dim{{end}}">{{$line}}</span>{{end}}</h2>
        </div>
        <div class="hp-show-aside" data-reveal>
          <p class="hp-lead">{{.T "home.editorial.extension.sub"}}</p>
          <a class="hp-more" href="{{.URL "/docs/plugin-dev"}}">{{.T "home.editorial.extension.link"}}<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <figure class="hp-show-shot" data-reveal>
        <img class="shot-dark" src="/website-assets/market/pluginmarket-dark.jpg?v={{assetV "market/pluginmarket-dark.jpg"}}" alt="{{.T "home.pillarShot.marketAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
        <img class="shot-light" src="/website-assets/market/pluginmarket-light.jpg?v={{assetV "market/pluginmarket-light.jpg"}}" alt="{{.T "home.pillarShot.marketAlt"}}" width="1440" height="900" loading="lazy" decoding="async">
      </figure>
      <ul class="hp-tags" data-reveal>
        <li>{{.T "home.extension.f1"}}</li>
        <li>{{.T "home.extension.f2"}}</li>
        <li>{{.T "home.extension.f3"}}</li>
        <li>{{.T "home.extension.f4"}}</li>
        <li class="hp-tags-note">{{.T "home.pillarShot.marketNote"}}</li>
      </ul>
    </div>
  </section>

  {{if .Features}}
  <section class="hp-section" id="capabilities">
    <div class="container">
      <div class="hp-section-head" data-reveal>
        <div>
          <p class="hp-kicker">{{.T "home.cap.fig"}}</p>
          <h2 class="hp-h2 hp-h2-sm">{{range $i, $line := titleLines (.T "home.cap.title")}}{{if $i}}<br>{{end}}<span class="hp-h2-line{{if $i}} dim{{end}}">{{$line}}</span>{{end}}</h2>
        </div>
        <div class="hp-section-aside">
          <p class="hp-lead">{{.T "home.cap.sub"}}</p>
          <a class="hp-more" href="{{.URL "/docs/features"}}">{{.T "home.cap.more"}}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hp-caps">
        {{range .Features}}
        <article class="hp-cap" data-reveal>
          <span class="hp-cap-icon" aria-hidden="true">{{icon .Icon}}</span>
          <h3>{{.Title}}</h3>
          <p>{{.Description}}</p>
        </article>
        {{end}}
      </div>

      <div class="hp-intg-block" data-reveal>
        <div class="hp-intg-intro">
          <h3>{{.T "home.intg.title"}}</h3>
          <p>{{.T "home.intg.sub"}}</p>
        </div>
        <ul class="hp-intg">
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "code"}}</span><span class="hp-intg-name">{{.T "home.intg.github"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindOauth"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "users"}}</span><span class="hp-intg-name">{{.T "home.intg.wecom"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindScan"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "bell"}}</span><span class="hp-intg-name">{{.T "home.intg.dingtalk"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindScan"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "zap"}}</span><span class="hp-intg-name">{{.T "home.intg.feishu"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindScan"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "box"}}</span><span class="hp-intg-name">{{.T "home.intg.s3"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindUpload"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "chart"}}</span><span class="hp-intg-name">{{.T "home.intg.prometheus"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindMetrics"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "key"}}</span><span class="hp-intg-name">{{.T "home.intg.oidc"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindIdp"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "plug"}}</span><span class="hp-intg-name">{{.T "home.intg.webhook"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindEvents"}}</span></li>
          <li><span class="hp-intg-icon" aria-hidden="true">{{icon "terminal"}}</span><span class="hp-intg-name">{{.T "home.intg.mcp"}}</span><span class="hp-intg-kind">{{.T "home.intg.kindTool"}}</span></li>
        </ul>
      </div>
    </div>
  </section>
  {{end}}

  {{if and .MarketEnabled .FeaturedPlugins}}
  <section class="hp-section" id="market">
    <div class="container">
      <div class="hp-section-head" data-reveal>
        <div>
          <p class="hp-kicker">{{.T "market.fig"}}</p>
          <h2 class="hp-h2 hp-h2-sm">{{range $i, $line := titleLines (.T "home.market.title")}}{{if $i}}<br>{{end}}<span class="hp-h2-line{{if $i}} dim{{end}}">{{$line}}</span>{{end}}</h2>
        </div>
        <div class="hp-section-aside">
          <p class="hp-lead">{{.T "home.market.sub"}}</p>
          <a class="hp-more" href="{{.URL "/plugins"}}">{{.T "home.market.more"}}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hp-market">
        {{range .FeaturedPlugins}}
        {{/* 与插件市场同口径：整张卡片可点，标题和「详情」不再各自套 <a>。 */}}
        <a class="hp-plugin" href="{{$.URL .DetailURL}}" aria-label="{{$.TF "market.detailAria" .Name}}" data-reveal>
          <header class="hp-plugin-head">
            <span class="hp-plugin-icon" aria-hidden="true">{{.Initial}}</span>
            <div class="hp-plugin-title">
              <h3>{{.Name}}</h3>
              <span class="hp-plugin-id">{{.ID}} · v{{.Version}}</span>
            </div>
            <span class="pill {{if .Pro}}pro{{end}}">{{if .Pro}}{{$.T "market.pro"}}{{else}}{{$.T "market.free"}}{{end}}</span>
          </header>
          <p class="hp-plugin-desc">{{.Description}}</p>
          <footer class="hp-plugin-foot">
            <span>{{.CategoryLabel}}</span>
            <span class="hp-plugin-more" aria-hidden="true">→</span>
          </footer>
        </a>
        {{end}}
      </div>
    </div>
  </section>
  {{end}}

  <section class="hp-section" id="quickstart">
    <div class="container hp-qs">
      <div class="hp-qs-copy" data-reveal>
        <p class="hp-kicker">{{.T "home.qs.kicker"}}</p>
        <h2 class="hp-h2">{{range $i, $line := titleLines (.T "home.qs.title")}}{{if $i}}<br>{{end}}<span class="hp-h2-line{{if $i}} dim{{end}}">{{$line}}</span>{{end}}</h2>
        <p class="hp-lead">{{.T "home.qs.sub"}}</p>
        <ol class="hp-steps">
          <li><b>{{.T "home.qs.build"}}</b>{{.T "home.qs.buildText"}}</li>
          <li><b>{{.T "home.qs.start"}}</b>{{.T "home.qs.startText"}}</li>
          <li><b>{{.T "home.qs.open"}} <code>/admin/setup</code></b>{{.T "home.qs.setupText"}}</li>
        </ol>
      </div>
      <div class="terminal" data-reveal role="img" aria-label="{{.T "home.qs.aria"}}">
        <div class="term-bar"><span class="bdot"></span><span class="bdot"></span><span class="bdot"></span><span class="term-title">sh — nexadmin</span></div>
        <pre class="term-body"><code><span class="tl"><span class="p">$</span> sh scripts/build.sh</span>
<span class="tl"><span class="c">web   npm ci + npm run build</span></span>
<span class="tl"><span class="c">build go build -tags embedweb</span></span>
<span class="tl"><span class="o">✓ bin/nexadmin-server</span></span>
<span class="tl"><span class="p">$</span> ./bin/nexadmin-server start</span>
<span class="tl"><span class="o">{{.T "home.term.setup"}}  http://localhost:8080/admin/setup</span></span>
<span class="tl"><span class="o">{{.T "home.term.token"}}  8f3a-…{{.T "home.term.tokenNote"}}</span></span>
<span class="tl"><span class="p">$</span> <span class="c">{{.T "home.term.hint"}}</span><span class="caret" aria-hidden="true"></span></span></code></pre>
      </div>
    </div>

    {{if .Faqs}}
    <div class="container">
      <div class="hp-faq-block" id="faq">
        <div class="hp-faq-intro" data-reveal>
          <h2 class="hp-h3">{{.T "home.faq.title"}}</h2>
          <div class="hp-faq-links">
            <a class="hp-more" href="{{.URL "/faq"}}">{{.T "home.faq.all"}}<span aria-hidden="true">→</span></a>
            <a class="hp-more" href="{{.URL "/contact"}}">{{.T "home.faq.more"}}<span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hp-faq" data-reveal>
          {{range .Faqs}}
          <details class="hp-faq-item">
            <summary>{{.Question}}</summary>
            <div class="hp-faq-answer">{{.Answer}}</div>
          </details>
          {{end}}
        </div>
      </div>
    </div>
    {{end}}
  </section>

  {{if .Posts}}
  <section class="hp-section" id="news">
    <div class="container">
      <div class="hp-section-head" data-reveal>
        <div>
          <p class="hp-kicker">{{.T "home.news.kicker"}}</p>
          <h2 class="hp-h2 hp-h2-sm">{{.T "home.news.title"}}</h2>
        </div>
        <div class="hp-section-aside hp-section-aside--action">
          <a class="hp-more" href="{{.URL "/news"}}">{{.T "home.news.more"}}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hp-posts">
        {{range .Posts}}
        <a class="hp-post" href="{{$.URL "/news"}}/{{.Slug}}" data-reveal>
          <time class="hp-post-date">{{if .PublishedAt}}{{fmtDate $.Lang .PublishedAt}}{{else}}{{fmtDate $.Lang .UpdatedAt}}{{end}}</time>
          <div class="hp-post-text">
            <h3>{{.Title}}</h3>
            {{if .Summary}}<p>{{.Summary}}</p>{{end}}
          </div>
          <span class="hp-post-arrow" aria-hidden="true">→</span>
        </a>
        {{end}}
      </div>
    </div>
  </section>
  {{end}}

  <section class="hp-cta">
    <div class="hp-cta-glow" aria-hidden="true"></div>
    <div class="container hp-cta-in" data-reveal>
      <h2>{{range $i, $line := titleLines (.T "home.cta.title")}}{{if $i}}<br>{{end}}{{$line}}{{end}}</h2>
      <p>{{.T "home.cta.sub"}}</p>
      <div class="hp-cta-actions">
        <a class="btn btn-primary" href="{{.URL .HomeCTAHref}}">{{.T "home.cta.primary"}}</a>
        <a class="btn btn-ghost" href="{{.URL "/docs"}}">{{.T "home.cta.secondary"}}</a>
      </div>
    </div>
  </section>

</div>
{{end}}

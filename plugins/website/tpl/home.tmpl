{{define "content"}}
<section class="hero">
  <!-- 弧带固定在界面卡背后，不穿过标题；窄屏隐藏，减少动态效果时静止。 -->
  <svg class="hero-arc" viewBox="0 0 1200 700" preserveAspectRatio="none" aria-hidden="true" focusable="false"
       data-parallax="34">
    <defs>
      <linearGradient id="heroArcGrad" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" style="stop-color: var(--hero-arc-deep)"></stop>
        <stop offset="0.45" style="stop-color: var(--hero-arc-mid)"></stop>
        <stop offset="1" style="stop-color: var(--hero-arc-tip)"></stop>
      </linearGradient>
      <filter id="heroArcShadow" x="-25%" y="-25%" width="150%" height="150%">
        <feDropShadow dx="0" dy="28" stdDeviation="28" flood-color="rgba(10, 12, 40, 0.45)"></feDropShadow>
      </filter>
    </defs>
    <path d="M-70 706 C 180 320, 620 150, 1270 300" fill="none" stroke="url(#heroArcGrad)" stroke-width="56"
          stroke-linecap="round" filter="url(#heroArcShadow)"></path>
    <path d="M-70 706 C 180 320, 620 150, 1270 300" fill="none" stroke="rgba(255,255,255,0.14)"
          stroke-width="9" stroke-linecap="round" transform="translate(0 -14)"></path>
  </svg>
  <div class="container hero-in">
    <a class="hero-badge" href="{{.URL "/news"}}" data-reveal>{{.T "home.badge"}}<span class="badge-arrow" aria-hidden="true">→</span></a>
    <h1 class="hero-title" data-reveal>
      {{- range $i, $line := titleLines .HomeTitle}}
      {{- if $i}}<br>{{end}}<span class="title-line">{{$line}}</span>
      {{- end}}
    </h1>
    {{if .HomeSubtitle}}<p class="hero-sub" data-reveal>{{.HomeSubtitle}}</p>{{end}}
    <div class="hero-cta" data-reveal>
      {{if .HomeCTALabel}}<a class="btn btn-primary" href="{{.URL .HomeCTAHref}}">{{.HomeCTALabel}}</a>{{end}}
      <a class="hero-link" href="#quickstart"><span aria-hidden="true">→</span>{{.T "home.heroQuickstart"}}</a>
    </div>

    <div class="hero-visual" data-reveal>
      <div class="hero-stage">
        <figure class="hero-shot" data-parallax>
          <img class="shot-dark" src="/website-assets/market/dashboard-dark.jpg?v={{assetV "market/dashboard-dark.jpg"}}" alt="{{.TF "home.heroShotAlt" .SiteName}}" width="1440" height="900" decoding="async">
          <img class="shot-light" src="/website-assets/market/dashboard-light.jpg?v={{assetV "market/dashboard-light.jpg"}}" alt="{{.TF "home.heroShotAlt" .SiteName}}" width="1440" height="900" decoding="async">
        </figure>
        <span class="hero-mark hero-mark--tl" aria-hidden="true"></span>
        <span class="hero-mark hero-mark--tr" aria-hidden="true"></span>
        <span class="hero-mark hero-mark--bl" aria-hidden="true"></span>
        <span class="hero-mark hero-mark--br" aria-hidden="true"></span>
        <p class="hero-caption"><span class="hero-caption-dot" aria-hidden="true"></span>{{.T "home.heroShotNote"}}</p>
      </div>
    </div>
  </div>
</section>

<section class="tech">
  <div class="container" data-reveal>
    <p class="tech-title">{{.T "home.tech.title"}}</p>
    <div class="tech-marquee">
      <div class="tech-track">
        <ul class="tech-list">
          <li>Go</li><li>Gin</li><li>GORM</li><li>React</li><li>TypeScript</li><li>shadcn/ui</li>
          <li>MySQL</li><li>MariaDB</li><li>PostgreSQL</li><li>Redis / Valkey</li>
        </ul>
        <ul class="tech-list" aria-hidden="true">
          <li>Go</li><li>Gin</li><li>GORM</li><li>React</li><li>TypeScript</li><li>shadcn/ui</li>
          <li>MySQL</li><li>MariaDB</li><li>PostgreSQL</li><li>Redis / Valkey</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="statement">
  <div class="container statement-in" data-reveal>
    <p class="fig">{{.T "home.statement.fig"}}</p>
    <p class="statement-copy"><span class="stmt-lead">{{.T "home.statement.strong"}}</span><span class="stmt-sub">{{.T "home.statement.rest"}}</span></p>
  </div>
</section>

<section class="section pillars" id="features">
  <div class="container">
    <div class="pillar" data-reveal>
      <h2>{{range $i, $line := titleLines (.T "home.editorial.platform.title")}}{{if $i}}<br>{{end}}{{$line}}{{end}}</h2>
      <div class="pillar-body">
        <p>{{.T "home.editorial.platform.sub"}}</p>
        <a class="learn-more" href="{{.URL "/docs/features"}}">{{.T "home.editorial.platform.link"}}<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="pillar" id="extension" data-reveal>
      <h2>{{range $i, $line := titleLines (.T "home.editorial.extension.title")}}{{if $i}}<br>{{end}}{{$line}}{{end}}</h2>
      <div class="pillar-body">
        <p>{{.T "home.editorial.extension.sub"}}</p>
        <a class="learn-more" href="{{.URL "/docs/plugin-dev"}}">{{.T "home.editorial.extension.link"}}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<section class="section integrations" id="integrations">
  <div class="container">
    <h3 class="intg-head" data-reveal>{{.T "home.editorial.intg.head"}}</h3>
    <ul class="intg-grid" data-reveal>
      <li><span class="intg-mark" aria-hidden="true">{{icon "code"}}</span><span class="intg-name">{{.T "home.intg.github"}}</span><span class="intg-kind">{{.T "home.intg.kindOauth"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "users"}}</span><span class="intg-name">{{.T "home.intg.wecom"}}</span><span class="intg-kind">{{.T "home.intg.kindScan"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "bell"}}</span><span class="intg-name">{{.T "home.intg.dingtalk"}}</span><span class="intg-kind">{{.T "home.intg.kindScan"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "zap"}}</span><span class="intg-name">{{.T "home.intg.feishu"}}</span><span class="intg-kind">{{.T "home.intg.kindScan"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "box"}}</span><span class="intg-name">{{.T "home.intg.s3"}}</span><span class="intg-kind">{{.T "home.intg.kindUpload"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "chart"}}</span><span class="intg-name">{{.T "home.intg.prometheus"}}</span><span class="intg-kind">{{.T "home.intg.kindMetrics"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "key"}}</span><span class="intg-name">{{.T "home.intg.oidc"}}</span><span class="intg-kind">{{.T "home.intg.kindIdp"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "plug"}}</span><span class="intg-name">{{.T "home.intg.webhook"}}</span><span class="intg-kind">{{.T "home.intg.kindEvents"}}</span></li>
      <li><span class="intg-mark" aria-hidden="true">{{icon "terminal"}}</span><span class="intg-name">{{.T "home.intg.mcp"}}</span><span class="intg-kind">{{.T "home.intg.kindTool"}}</span></li>
    </ul>
  </div>
</section>

{{if .Features}}
<section class="section cap-index" id="capabilities">
  <div class="container">
    <div class="cap-head" data-reveal>
      <p class="fig">{{.T "home.cap.fig"}}</p>
      <a class="section-more" href="{{.URL "/docs/features"}}">{{.T "home.cap.more"}}</a>
    </div>
    <div class="cap-grid">
      {{range .Features}}
      <article class="cap" data-reveal>
        <span class="cap-icon" aria-hidden="true">{{icon .Icon}}</span>
        <h3>{{.Title}}</h3>
        <p>{{.Description}}</p>
      </article>
      {{end}}
    </div>
  </div>
</section>
{{end}}

<section class="section" id="product">
  <div class="container">
    <header class="section-head home-head" data-reveal>
      <div class="section-copy">
        <h2>{{.T "home.product.title"}}</h2>
      </div>
      <div class="section-side">
        <p class="section-sub">{{.T "home.product.sub"}}</p>
        <a class="section-more" href="/admin/login">{{.T "layout.login"}}</a>
      </div>
    </header>
    <!-- 首屏已经展示过工作台截图，这里不再重复贴图，用文字列出真实存在的三块界面 -->
    <ul class="product-facts" data-reveal>
      <li><h3>{{.T "home.product.shot.user"}}</h3></li>
      <li><h3>{{.T "home.product.shot.menu"}}</h3></li>
      <li><h3>{{.T "home.product.shot.siteset"}}</h3></li>
    </ul>
  </div>
</section>

{{if and .MarketEnabled .FeaturedPlugins}}
<section class="section" id="market">
  <div class="container">
    <header class="section-head home-head" data-reveal>
      <div class="section-copy">
        <h2>{{.T "home.market.title"}}</h2>
      </div>
      <div class="section-side">
        <p class="section-sub">{{.T "home.market.sub"}}</p>
        <a class="section-more" href="{{.URL "/plugins"}}">{{.T "home.market.more"}}</a>
      </div>
    </header>
    <div class="plugin-grid">
      {{range .FeaturedPlugins}}
      <article class="plugin-card" data-reveal>
        <!-- 去掉封面图，只用图标和色块 -->
        <header class="plugin-card-head">
          <span class="plugin-icon" aria-hidden="true">{{.Initial}}</span>
          <div class="plugin-title">
            <h3><a href="{{$.URL .DetailURL}}">{{.Name}}</a></h3>
            <span class="plugin-id">{{.ID}} · v{{.Version}}</span>
          </div>
          <span class="pill {{if .Pro}}pro{{end}}">{{if .Pro}}{{$.T "market.pro"}}{{else}}{{$.T "market.free"}}{{end}}</span>
        </header>
        <p class="plugin-desc">{{.Description}}</p>
        <div class="plugin-stats-line">
          {{if .RatingCount}}<span class="plugin-rating">★ {{.RatingAvg}} <small>({{.RatingCount}})</small></span>{{end}}
          {{if .Downloads}}<span>{{$.TN .Downloads "market.downloads" .DownloadsText}}</span>{{end}}
        </div>
        <footer class="plugin-card-foot">
          <span class="plugin-cat">{{.CategoryLabel}}</span>
          <a class="plugin-link" href="{{$.URL .DetailURL}}" aria-label="{{$.TF "market.detailAria" .Name}}">{{$.T "market.detail"}}</a>
        </footer>
      </article>
      {{end}}
    </div>
  </div>
</section>
{{end}}

{{if .Posts}}
<section class="section" id="news">
  <div class="container">
    <header class="section-head home-head" data-reveal>
      <div class="section-copy">
        <h2>{{.T "home.news.title"}}</h2>
      </div>
      <div class="section-side">
        <a class="section-more" href="{{.URL "/news"}}">{{.T "home.news.more"}}</a>
      </div>
    </header>
    <div class="home-posts">
      {{range .Posts}}
      <a class="home-post" href="{{$.URL "/news"}}/{{.Slug}}" data-reveal>
        <time class="post-date">{{if .PublishedAt}}{{fmtDate $.Lang .PublishedAt}}{{else}}{{fmtDate $.Lang .UpdatedAt}}{{end}}</time>
        <div class="home-post-text">
          <h3>{{.Title}}</h3>
          {{if .Summary}}<p>{{.Summary}}</p>{{end}}
        </div>
        <span class="home-post-arrow" aria-hidden="true">→</span>
      </a>
      {{end}}
    </div>
  </div>
</section>
{{end}}

<section class="section" id="quickstart">
  <div class="container qs-grid">
    <div class="qs-copy" data-reveal>
      <h2>{{.T "home.qs.title"}}</h2>
      <p class="section-sub">{{.T "home.qs.sub"}}</p>
      <ol class="qs-steps">
        <li><b>{{.T "home.qs.build"}}</b>{{.T "home.qs.buildText"}}</li>
        <li><b>{{.T "home.qs.start"}}</b>{{.T "home.qs.startText"}}</li>
        <li><b>{{.T "home.qs.open"}} <code>/setup</code></b>{{.T "home.qs.setupText"}}</li>
      </ol>
      <p class="qs-note">{{.T "home.qs.notePre"}}<code>go run ./cmd/server</code>{{.T "home.qs.noteMid"}}<code>cd web &amp;&amp; npm run dev</code>{{.T "home.qs.notePost"}}</p>
    </div>
    <div class="terminal" data-reveal role="img" aria-label="{{.T "home.qs.aria"}}">
      <div class="term-bar"><span class="bdot"></span><span class="bdot"></span><span class="bdot"></span><span class="term-title">sh — nexadmin</span></div>
      <pre class="term-body"><code><span class="tl"><span class="p">$</span> sh scripts/build.sh</span>
<span class="tl"><span class="c">web   npm ci + npm run build</span></span>
<span class="tl"><span class="c">build go build -tags embedweb</span></span>
<span class="tl"><span class="o">✓ bin/nexadmin-server</span></span>
<span class="tl"><span class="p">$</span> ./bin/nexadmin-server start</span>
<span class="tl"><span class="o">{{.T "home.term.setup"}}  http://localhost:8080/setup</span></span>
<span class="tl"><span class="o">{{.T "home.term.token"}}  8f3a-…{{.T "home.term.tokenNote"}}</span></span>
<span class="tl"><span class="p">$</span> <span class="c">{{.T "home.term.hint"}}</span><span class="caret" aria-hidden="true"></span></span></code></pre>
    </div>
  </div>
</section>

<section class="quote">
  <div class="container quote-in" data-reveal>
    <blockquote>{{.T "home.quote.body"}}</blockquote>
    <p class="quote-by">{{.T "home.quote.by"}}</p>
  </div>
</section>

<section class="cta">
  <div class="container cta-in" data-reveal>
    <h2>{{.T "home.cta.title"}}</h2>
    <p>{{.T "home.cta.sub"}}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="{{.URL "#quickstart"}}">{{.T "home.cta.primary"}}</a>
      <a class="btn btn-ghost" href="{{.URL "/p/about"}}">{{.T "home.cta.secondary"}}</a>
    </div>
  </div>
</section>
{{end}}

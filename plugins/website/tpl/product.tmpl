{{define "content"}}
<article class="section article">
  <div class="container article-in">
    <header class="article-head">
      {{if .Product.Categories}}
      <p class="article-term">
        <span class="article-term-label">{{.T "products.categoryLabel"}}</span>
        {{range .Product.Categories}}<a class="chip" href="{{$.URL "/products"}}?category={{.Slug}}">{{.Title}}</a>{{end}}
      </p>
      {{end}}
      <h1 class="page-title">{{.Product.Title}}</h1>
      {{if .Product.PriceMin}}
      <p class="product-price-line">
        <span class="product-price">
          {{if and .Product.PriceMax (gt .Product.PriceMax .Product.PriceMin)}}{{printf "%.2f" .Product.PriceMin}} - {{printf "%.2f" .Product.PriceMax}}{{else}}{{printf "%.2f" .Product.PriceMin}}{{end}}
          {{.Product.Currency}}{{if .Product.PriceUnit}} / {{.Product.PriceUnit}}{{end}}
        </span>
      </p>
      {{end}}
      {{if .Product.Summary}}<p class="product-summary">{{.Product.Summary}}</p>{{end}}
    </header>
    {{if or .Product.CoverURL .Product.ProductImages}}
    <div class="product-gallery" data-product-gallery>
      {{if .Product.CoverURL}}<img class="product-gallery-main" src="{{.Product.CoverURL}}" alt="{{.Product.Title}}">{{end}}
      {{range .Product.ProductImages}}<button type="button" class="product-gallery-thumb" data-gallery-src="{{.}}" aria-label="{{$.T "products.galleryThumbAria"}}"><img src="{{.}}" alt="" loading="lazy"></button>{{end}}
    </div>
    {{end}}
    {{if .Product.VideoURL}}
      {{if isMediaURL .Product.VideoURL}}
      <video class="product-video" src="{{.Product.VideoURL}}" controls preload="metadata"></video>
      {{else}}
      <p class="product-video-link"><a class="chip" href="{{.Product.VideoURL}}" target="_blank" rel="noopener">{{.T "products.watchVideo"}}</a></p>
      {{end}}
    {{end}}
    {{if or .Product.PaymentTerms .Product.Moq .Product.LeadTimeDays .Product.Port}}
    <table class="product-specs product-trade">
      <caption>{{.T "products.tradeTitle"}}</caption>
      <tbody>
        {{if .Product.PaymentTerms}}<tr><th scope="row">{{.T "products.paymentTerms"}}</th><td>{{.Product.PaymentTerms}}</td></tr>{{end}}
        {{if .Product.Moq}}<tr><th scope="row">{{.T "products.moqLabel"}}</th><td>{{.Product.Moq}}</td></tr>{{end}}
        {{if .Product.LeadTimeDays}}<tr><th scope="row">{{.T "products.leadTimeLabel"}}</th><td>{{.TF "products.leadTime" .Product.LeadTimeDays}}</td></tr>{{end}}
        {{if .Product.Port}}<tr><th scope="row">{{.T "products.portLabel"}}</th><td>{{.Product.Port}}</td></tr>{{end}}
      </tbody>
    </table>
    {{end}}
    {{if .Product.ProductSpecs}}
    <table class="product-specs">
      <caption>{{.T "products.specsTitle"}}</caption>
      <tbody>
        {{range .Product.ProductSpecs}}
        <tr><th scope="row">{{.Label}}</th><td>{{.Value}}</td></tr>
        {{end}}
      </tbody>
    </table>
    {{end}}
    {{if .Product.Content}}<div class="article-body">{{safeHTML .Product.Content}}</div>{{end}}
    {{if .ProductsRelated}}
    <section class="product-related" aria-labelledby="product-related-title">
      <h2 id="product-related-title">{{.T "products.relatedTitle"}}</h2>
      <div class="product-grid">
        {{range .ProductsRelated}}
        <a class="product-card" href="{{$.URL "/products"}}/{{.Slug}}">
          <span class="product-card-cover">
            {{if .CoverURL}}<img src="{{.CoverURL}}" alt="" loading="lazy">{{else}}<span class="product-card-fallback" aria-hidden="true">{{initial .Title}}</span>{{end}}
          </span>
          <span class="product-card-body">
            <span class="product-card-title">{{.Title}}</span>
            {{if .PriceMin}}<span class="product-card-price">{{printf "%.2f" .PriceMin}} {{.Currency}}{{if .PriceUnit}} / {{.PriceUnit}}{{end}}</span>{{end}}
          </span>
        </a>
        {{end}}
      </div>
    </section>
    {{end}}
    <footer class="article-terms">
      <p class="article-term"><span class="article-term-label">{{.T "products.inquiryLabel"}}</span><a class="chip" href="{{.URL "/contact"}}">{{.T "products.inquiryCta"}}</a></p>
    </footer>
    <p class="article-back"><a href="{{.URL "/products"}}">{{.T "products.back"}}</a></p>
  </div>
</article>
{{end}}

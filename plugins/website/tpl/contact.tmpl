{{define "content"}}
<section class="section contact-page">
  <div class="container contact-grid">
    <div class="contact-intro">
      <h1 class="page-title">{{.T "contact.title"}}</h1>
      <p class="contact-lede">{{.TF "contact.lede" .SiteName}}</p>

      <ul class="contact-channels">
        {{if .ContactEmail}}
        <li>
          <span class="contact-ico" aria-hidden="true">{{icon "mail"}}</span>
          <div>
            <span class="contact-label">{{.T "contact.email"}}</span>
            <a href="mailto:{{.ContactEmail}}">{{.ContactEmail}}</a>
          </div>
        </li>
        {{end}}
        {{if .ContactPhone}}
        <li>
          <span class="contact-ico" aria-hidden="true">{{icon "phone"}}</span>
          <div>
            <span class="contact-label">{{.T "contact.phone"}}</span>
            <a href="tel:{{.ContactPhone}}">{{.ContactPhone}}</a>
          </div>
        </li>
        {{end}}
      </ul>

      {{/* 办公地点（站点设置可配，多个）：地点卡纯 HTML 可被收录；地图按访客语言
          判定厂商（zh 系→天地图，其他→谷歌），对应厂商未启用时只渲染地点卡。 */}}
      {{if .Offices}}
      <div class="contact-offices">
        <span class="contact-label contact-offices-title">{{.T "contact.offices"}}</span>
        {{range .Offices}}
        <div class="office-card">
          {{if .Name}}<strong class="office-name">{{.Name}}</strong>{{end}}
          {{if .Address}}<p class="office-address">{{.Address}}</p>{{end}}
        </div>
        {{end}}
        {{if and .MapProvider (index .Offices 0).HasCoords}}
        {{if eq .MapProvider "google"}}
        {{/* 谷歌 iframe embed 无需 Key，访客直接可拖拽缩放 */}}
        <iframe class="office-map" src="https://maps.google.com/maps?q={{(index .Offices 0).Lat}},{{(index .Offices 0).Lng}}&hl={{.Lang.HTMLLang}}&z=15&output=embed" loading="lazy" title="{{.T "contact.officeMap"}}"></iframe>
        {{else}}
        {{/* 天地图：浏览器 tk 由 maps 插件配置下发，API 脚本同步加载后 site.js 打点 */}}
        <div class="office-map" data-office-map data-lng="{{(index .Offices 0).Lng}}" data-lat="{{(index .Offices 0).Lat}}" data-label="{{(index .Offices 0).Name}}"></div>
        {{end}}
        {{end}}
      </div>
      {{if eq .MapProvider "tianditu"}}<script src="https://api.tianditu.gov.cn/api?v=4.0&tk={{.TiandituTK}}"></script>{{end}}
      {{end}}

      {{if .Socials}}
      <ul class="footer-social contact-social" aria-label="{{.T "layout.social"}}">
        {{range .Socials}}<li><a href="{{.URL}}" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{$.SocialLabel .Platform}}" data-tip="{{$.SocialLabel .Platform}}">{{socialIcon .Platform}}</a></li>{{end}}
      </ul>
      {{end}}

      {{if .QRCodeURL}}
      <figure class="footer-qr contact-qr">
        <img src="{{.QRCodeURL}}" alt="{{if .QRCodeCaption}}{{.QRCodeCaption}}{{else}}{{.T "layout.qrAlt"}}{{end}}" loading="lazy" width="96" height="96">
        {{if .QRCodeCaption}}<figcaption>{{.QRCodeCaption}}</figcaption>{{end}}
      </figure>
      {{end}}
    </div>

    <form class="contact-form" method="post" action="{{.URL "/contact"}}" data-contact-form novalidate>
      <h2 class="contact-form-title">{{.T "contact.formTitle"}}</h2>

      <p class="contact-status" data-contact-status role="status" aria-live="polite"{{if and (not .ContactSent) (not .ContactError)}} hidden{{end}}>
        {{if .ContactSent}}<span class="contact-status-ok">{{.T "contact.sent"}}</span>{{end}}
        {{if .ContactError}}<span class="contact-status-err">{{.ContactError}}</span>{{end}}
      </p>

      <label class="field">
        <span class="field-label">{{.T "contact.name"}}</span>
        <input name="name" required maxlength="64" autocomplete="name" placeholder="{{.T "contact.namePh"}}">
      </label>
      <label class="field">
        <span class="field-label">{{.T "contact.email"}}</span>
        <input name="email" type="email" required maxlength="128" autocomplete="email" placeholder="{{.T "contact.emailPh"}}">
      </label>
      <label class="field">
        <span class="field-label">{{.T "contact.phoneOpt"}}</span>
        <input name="phone" type="tel" maxlength="32" autocomplete="tel" placeholder="{{.T "contact.phonePh"}}">
      </label>
      <label class="field">
        <span class="field-label">{{.T "contact.message"}}</span>
        <textarea name="content" rows="5" required minlength="5" maxlength="2000" placeholder="{{.T "contact.messagePh"}}"></textarea>
      </label>
      <label class="contact-hp" aria-hidden="true">
        <span>Company</span>
        <input name="company" tabindex="-1" autocomplete="off">
      </label>
      {{if .Consent}}
      <label class="contact-consent">
        <input type="checkbox" name="consent" value="1" required>
        <span>{{.T "contact.consent"}} <a href="{{.ConsentURL}}" target="_blank" rel="noopener noreferrer">{{.T "contact.consentPolicy"}}</a></span>
      </label>
      {{end}}
      <div class="contact-actions">
        <button class="btn btn-primary" type="submit">{{.T "contact.send"}}</button>
        <p class="contact-form-hint">
          {{if .ContactEmail}}{{.T "contact.orEmail"}} <a href="mailto:{{.ContactEmail}}">{{.ContactEmail}}</a>{{else}}{{.T "contact.formHint"}}{{end}}
        </p>
      </div>
    </form>
  </div>
</section>
{{end}}

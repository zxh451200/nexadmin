{{define "content"}}
<div class="docs-shell">
  <aside class="docs-side" aria-label="{{.T "docs.title"}}">
    <label class="docs-search">
      <span class="sr-only">{{.T "docs.search"}}</span>
      <input type="search" data-docs-search placeholder="{{.T "docs.search"}}" autocomplete="off" aria-controls="docs-search-results" aria-describedby="docs-search-hint">
    </label>
    <p class="docs-search-hint" id="docs-search-hint">{{.T "docs.search.hint"}}</p>
    <details class="docs-disclosure" data-docs-disclosure="760">
      <summary>{{.T "docs.title"}}</summary>
      <nav aria-label="{{.T "docs.title"}}">
        {{range .DocNav}}
        {{$open := false}}{{range .Items}}{{if .Active}}{{$open = true}}{{end}}{{end}}
        <details class="docs-group"{{if $open}} open{{end}}>
          <summary class="docs-group-title">{{.Title}}</summary>
          <ul>
            {{range .Items}}<li><a href="{{.URL}}" lang="{{.Language}}"{{if .Active}} class="active" aria-current="page"{{end}}>{{.Title}}</a></li>{{end}}
          </ul>
        </details>
        {{end}}
      </nav>
    </details>
  </aside>

  {{if .Doc.TOC}}
  <aside class="docs-toc-side" aria-label="{{.T "docs.group.toc"}}">
    <details class="docs-disclosure" data-docs-disclosure="1200">
      <summary>{{.T "docs.group.toc"}}</summary>
      <nav aria-label="{{.T "docs.group.toc"}}">
        <ul class="docs-toc" lang="{{.Doc.Language}}">
          {{range .Doc.TOC}}<li class="toc-h{{.Level}}"><a href="{{.Href}}">{{.Text}}</a></li>{{end}}
        </ul>
      </nav>
    </details>
  </aside>
  {{end}}

  <div class="docs-main">
    <div id="docs-search-index" hidden>{{.DocSearchIndexJSON}}</div>
    <section class="docs-search-results" id="docs-search-results" aria-labelledby="docs-search-title" hidden>
      <h2 id="docs-search-title">{{.T "docs.search.results"}}</h2>
      <p data-docs-search-status role="status" aria-live="polite" aria-atomic="true" data-count-one="{{.T "docs.search.count.one"}}" data-count-other="{{.T "docs.search.count.other"}}" data-empty="{{.T "docs.search.empty"}}" data-unavailable="{{.T "docs.search.unavailable"}}"></p>
      <ul data-docs-search-list data-fallback="{{.T "docs.sourceLabel"}}"></ul>
    </section>
    <article class="docs-body article-body" data-reveal>
      <nav class="docs-crumbs" aria-label="{{.T "plugin.breadcrumb"}}">
        <a href="{{.URL "/docs"}}">{{.T "layout.docs"}}</a>
        <span aria-hidden="true">/</span>
        <span lang="{{.Doc.Language}}">{{.Doc.Title}}</span>
      </nav>
      {{if .Doc.IsFallback}}<p class="docs-source-note">{{.T "docs.sourceFallback"}}</p>{{end}}
      <div class="docs-content" lang="{{.Doc.Language}}">
        <h1>{{.Doc.Title}}</h1>
        {{.Doc.Content}}
      </div>
      {{if or .DocPrev .DocNext}}
      <nav class="docs-pager" aria-label="{{.T "docs.pagination"}}">
        {{if .DocPrev}}
        <a class="docs-page-link prev" href="{{.DocPrev.URL}}">
          <small>{{.T "docs.prev"}}</small>
          <span lang="{{.DocPrev.Language}}">{{.DocPrev.Title}}</span>
        </a>
        {{else}}<span></span>{{end}}
        {{if .DocNext}}
        <a class="docs-page-link next" href="{{.DocNext.URL}}">
          <small>{{.T "docs.next"}}</small>
          <span lang="{{.DocNext.Language}}">{{.DocNext.Title}}</span>
        </a>
        {{end}}
      </nav>
      {{end}}
      <p class="docs-foot">{{.T "docs.footerHint"}} <a href="{{.URL "/news"}}">{{.T "layout.news"}} →</a></p>
    </article>
  </div>
</div>
{{end}}

{{define "content"}}
<article class="section article">
  <div class="container article-in">
    <header class="article-head">
      {{if .Post.PublishedAt}}<time class="article-date">{{fmtDate .Lang .Post.PublishedAt}}</time>{{end}}
      {{if or .Post.Author .Post.Views}}<p class="article-meta">{{if .Post.Author}}{{.Post.Author}} · {{end}}{{if .Post.Views}}{{.T "post.views"}}：{{.Post.Views}}{{end}}</p>{{end}}
      <h1 class="page-title">{{.Post.Title}}</h1>
    </header>
    {{if .Post.CoverURL}}<img class="article-cover" src="{{.Post.CoverURL}}" alt="">{{end}}
    <div class="article-body">{{safeHTML .Post.Content}}</div>
    {{if or .Post.Categories .Post.Tags}}
    <footer class="article-terms">
      {{if .Post.Categories}}
      <p class="article-term"><span class="article-term-label">{{.T "post.categoryLabel"}}</span>{{range .Post.Categories}}<a class="chip" href="{{$.URL "/news"}}?category={{.Slug}}">{{.Title}}</a>{{end}}</p>
      {{end}}
      {{if .Post.Tags}}
      <p class="article-term"><span class="article-term-label">{{.T "post.tagLabel"}}</span>{{range .Post.Tags}}<a class="chip" href="{{$.URL "/news"}}?tag={{.Slug}}">{{.Name}}</a>{{end}}</p>
      {{end}}
    </footer>
    {{end}}
    <p class="article-back"><a href="{{.URL "/news"}}">{{.T "news.back"}}</a></p>
  </div>
</article>
{{end}}

{{define "content"}}
<section class="tk-section tk-contact">
  <div class="tk-wrap tk-contact-grid">
    <div class="tk-contact-intro" data-reveal>
      <p class="tk-eyebrow">{{.T "contact.eyebrow"}}</p>
      <h1 class="tk-page-title">{{.T "contact.title"}}</h1>
      <p class="tk-page-sub">{{.TF "contact.lede" .SiteName}}</p>
      <ul class="tk-contact-channels">
        {{if .ContactEmail}}
        <li>
          <span class="tk-contact-ico" aria-hidden="true">{{icon "mail"}}</span>
          <div><span class="tk-contact-label">{{.T "contact.email"}}</span><a href="mailto:{{.ContactEmail}}">{{.ContactEmail}}</a></div>
        </li>
        {{end}}
        {{if .ContactPhone}}
        <li>
          <span class="tk-contact-ico" aria-hidden="true">{{icon "phone"}}</span>
          <div><span class="tk-contact-label">{{.T "contact.phone"}}</span><a href="tel:{{.ContactPhone}}">{{.ContactPhone}}</a></div>
        </li>
        {{end}}
      </ul>
      {{if .Socials}}
      <ul class="tk-social tk-contact-social" aria-label="{{.T "layout.social"}}">
        {{range .Socials}}<li><a href="{{.URL}}" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{$.SocialLabel .Platform}}" title="{{$.SocialLabel .Platform}}">{{socialIcon .Platform}}</a></li>{{end}}
      </ul>
      {{end}}
      {{if .QRCodeURL}}
      <figure class="tk-footer-qr tk-contact-qr">
        <img src="{{.QRCodeURL}}" alt="{{if .QRCodeCaption}}{{.QRCodeCaption}}{{else}}{{.T "layout.qrAlt"}}{{end}}" loading="lazy" width="96" height="96">
        {{if .QRCodeCaption}}<figcaption>{{.QRCodeCaption}}</figcaption>{{end}}
      </figure>
      {{end}}
    </div>
    <form class="tk-contact-form" method="post" action="{{.URL "/contact"}}" data-contact-form novalidate>
      <h2 class="tk-contact-form-title">{{.T "contact.formTitle"}}</h2>
      <p class="tk-contact-form-hint">{{.T "contact.formHint"}}</p>
      <p class="tk-contact-status" data-contact-status role="status" aria-live="polite"{{if and (not .ContactSent) (not .ContactError)}} hidden{{end}}>
        {{if .ContactSent}}<span class="tk-contact-ok">{{.T "contact.sent"}}</span>{{end}}
        {{if .ContactError}}<span class="tk-contact-err">{{.ContactError}}</span>{{end}}
      </p>
      <label class="tk-field"><span>{{.T "contact.name"}}</span><input name="name" required maxlength="64" autocomplete="name"></label>
      <label class="tk-field"><span>{{.T "contact.email"}}</span><input name="email" type="email" required maxlength="128" autocomplete="email"></label>
      <label class="tk-field"><span>{{.T "contact.phoneOpt"}}</span><input name="phone" type="tel" maxlength="32" autocomplete="tel"></label>
      <label class="tk-field"><span>{{.T "contact.message"}}</span><textarea name="content" rows="5" required minlength="5" maxlength="2000"></textarea></label>
      <label class="tk-contact-hp" aria-hidden="true"><span>Company</span><input name="company" tabindex="-1" autocomplete="off"></label>
      {{if .Consent}}
      <label class="tk-consent">
        <input type="checkbox" name="consent" value="1" required>
        <span>{{.T "contact.consent"}} <a href="{{.ConsentURL}}" target="_blank" rel="noopener noreferrer">{{.T "contact.consentPolicy"}}</a></span>
      </label>
      {{end}}
      <button class="tk-btn tk-btn-red" type="submit">{{.T "contact.send"}}</button>
    </form>
  </div>
</section>
{{end}}

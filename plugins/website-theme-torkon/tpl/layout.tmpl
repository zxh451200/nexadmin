{{define "layout"}}<!doctype html>
<html lang="{{.Lang.HTMLLang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{if .SeoTitle}}{{.SeoTitle}}{{else}}{{.Title}}{{end}}</title>
{{if .Desc}}<meta name="description" content="{{.Desc}}">{{end}}
{{if .SeoKeywords}}<meta name="keywords" content="{{.SeoKeywords}}">{{end}}
{{if .Noindex}}<meta name="robots" content="noindex">{{end}}
<link rel="canonical" href="{{.Canonical}}">
{{range .Languages}}<link rel="alternate" hreflang="{{.HTMLLang}}" href="{{$.BaseURL}}{{$.Alternate .}}">{{end}}
{{range .Languages}}{{if .Default}}<link rel="alternate" hreflang="x-default" href="{{$.BaseURL}}{{$.Alternate .}}">{{end}}{{end}}
<meta name="theme-color" content="#111214">
<link rel="icon" href="{{if .FaviconURL}}{{.FaviconURL}}{{else}}/website-assets/theme/torkon/favicon.svg{{end}}" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="{{.SiteName}}" href="{{.BaseURL}}/rss.xml">
<link rel="alternate" type="application/atom+xml" title="{{.SiteName}}" href="{{.BaseURL}}/atom.xml">
{{/* sitemap 自动发现：robots.txt 的 Sitemap: 是主通道，这个标签供 Bing/Yandex 等抓取器兜底。 */}}
<link rel="sitemap" type="application/xml" title="{{.SiteName}}" href="{{.BaseURL}}/sitemap.xml">
<meta property="og:type" content="{{if .OGType}}{{.OGType}}{{else}}website{{end}}">
<meta property="og:site_name" content="{{.SiteName}}">
<meta property="og:title" content="{{if .SeoTitle}}{{.SeoTitle}}{{else}}{{.Title}}{{end}}">
<meta property="og:description" content="{{.Desc}}">
<meta property="og:url" content="{{.Canonical}}">
<meta property="og:image" content="{{if .OGImage}}{{.OGImage}}{{else}}{{.BaseURL}}/website-assets/og.png{{end}}">
{{if not .OGImage}}<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">{{end}}
{{if .OGPublishedAt}}<meta property="article:published_time" content="{{.OGPublishedAt}}">{{end}}
<meta property="og:locale" content="{{.Lang.OGLocale}}">
{{range .Languages}}{{if ne .Code $.Lang.Code}}<meta property="og:locale:alternate" content="{{.OGLocale}}">{{end}}{{end}}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{if .SeoTitle}}{{.SeoTitle}}{{else}}{{.Title}}{{end}}">
<meta name="twitter:description" content="{{.Desc}}">
<meta name="twitter:image" content="{{if .OGImage}}{{.OGImage}}{{else}}{{.BaseURL}}/website-assets/og.png{{end}}">
{{if .OrgLD}}<script type="application/ld+json">{{.OrgLD}}</script>{{end}}
{{if .PageLD}}<script type="application/ld+json">{{.PageLD}}</script>{{end}}
{{if .PluginLD}}<script type="application/ld+json">{{.PluginLD}}</script>{{end}}
{{if .HeadCode}}{{.HeadCode}}{{end}}
<link rel="stylesheet" href="/website-assets/theme/torkon/site.css?v={{assetV "theme/torkon/site.css"}}">
{{if or (eq .Route "/products") (hasPrefix .Route "/products/") (hasPrefix .Route "/orders/")}}<link rel="stylesheet" href="/website-assets/site-pd.css?v={{assetV "site-pd.css"}}">{{end}}
<noscript><style>[data-reveal]{opacity:1;transform:none}[role="tabpanel"][hidden]{display:block !important}.tk-mnav[hidden]{display:block !important}</style></noscript>
</head>
<body>
<a class="skip-link" href="#main">{{.T "layout.skip"}}</a>
{{if .Suggest}}
<div class="tk-langbanner" data-lang-banner>
  <div class="tk-wrap tk-langbanner-in">
    <span>{{.TF "lang.suggest" .SuggestLang.Label}}</span>
    <a class="tk-langbanner-cta" href="{{.Alternate .SuggestLang}}" hreflang="{{.SuggestLang.HTMLLang}}" lang="{{.SuggestLang.HTMLLang}}">{{.TF "lang.suggestCta" .SuggestLang.Label}} →</a>
    <button class="tk-langbanner-close" type="button" data-lang-banner-close aria-label="{{.T "lang.close"}}">×</button>
  </div>
</div>
{{end}}
<!-- 顶部信息条：电话与邮箱来自站点设置，空则整条隐藏 -->
{{if or .ContactPhone .ContactEmail}}
<div class="tk-utility">
  <div class="tk-wrap tk-utility-in">
    <span class="tk-utility-note">{{.T "theme.torkon.utilityNote"}}</span>
    <span class="tk-utility-contacts">
      {{if .ContactPhone}}<a href="tel:{{.ContactPhone}}">☎ {{.ContactPhone}}</a>{{end}}
      {{if .ContactEmail}}<a href="mailto:{{.ContactEmail}}" data-copy-email="{{.ContactEmail}}" title="{{.T "site.js.emailCopy"}}">✉ {{.ContactEmail}}</a>{{end}}
    </span>
  </div>
</div>
{{end}}
<header class="tk-header" id="top">
  <div class="tk-wrap tk-header-in">
    <a class="tk-brand" href="{{.Home}}" aria-label="{{.TF "layout.homeAria" .SiteName}}">
      {{if .LogoURL}}<img class="tk-brand-logo" src="{{.LogoURL}}" alt="{{.SiteName}}">{{else}}<span class="tk-brand-text">{{initial .SiteName}}</span>{{end}}
    </a>
    <!-- 首页导航住在 hero 左侧竖栏里（参考稿的顶栏是搜索/账户簇，不是链接排）；内页没有侧栏，顶栏保留导航 -->
    {{if ne .Route "/"}}
    <nav class="tk-nav" aria-label="{{.T "layout.mainNav"}}">
      {{range .Navs}}{{if .Children}}
      <details class="tk-navsub">
        <summary>{{.Label}}</summary>
        <ul>{{range .Children}}<li><a href="{{$.URL .Href}}">{{.Label}}</a></li>{{end}}</ul>
      </details>
      {{else}}<a href="{{$.URL .Href}}"{{if eq .Href $.Route}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}{{end}}
    </nav>
    {{end}}
    <!-- 搜索位：参考稿顶栏是一枚横跨的搜索框；这里没有全文检索后端，落到产品中心当型号检索入口 -->
    <a class="tk-search" href="{{.URL "/products"}}">
      <span>{{.T "theme.torkon.searchPlaceholder"}}</span>
      {{icon "search"}}
    </a>
    <div class="tk-header-actions">
      <a class="tk-hlink" href="{{.URL "/products"}}">{{icon "users"}}<span>{{.T "theme.torkon.findDealer"}}</span></a>
      <span class="tk-hsep" aria-hidden="true"></span>
      <a class="tk-hlink" href="{{.URL "/contact"}}">{{icon "mail"}}<span>{{.T "theme.torkon.account"}}</span></a>
      <details class="tk-lang">
        <summary aria-label="{{.T "layout.lang"}}">{{.Lang.Label}}</summary>
        <div class="tk-langmenu">
          {{range .Languages}}<a href="{{$.Switch .}}" hreflang="{{.HTMLLang}}" lang="{{.HTMLLang}}"{{if eq .Code $.Lang.Code}} aria-current="true"{{end}}>{{.Label}}</a>{{end}}
        </div>
      </details>
      {{if ne .Route "/"}}<a class="tk-btn tk-btn-red" href="{{.URL "/contact"}}">{{.T "theme.torkon.quote"}}</a>{{end}}
      <details class="tk-mnav-btn">
        <summary aria-label="{{.T "layout.mainNav"}}"><span></span><span></span><span></span></summary>
        <div class="tk-mnav">
          {{range .Navs}}<a href="{{$.URL .Href}}">{{.Label}}</a>{{end}}
          <a href="{{$.URL "/contact"}}">{{$.T "theme.torkon.quote"}}</a>
        </div>
      </details>
    </div>
  </div>
</header>
<main id="main">
{{template "content" .}}
</main>
<footer class="tk-footer">
  <div class="tk-wrap tk-footer-grid{{if .FooterNavs}} tk-footer-grid-nav{{end}}">
    <div class="tk-footer-brand">
      <a class="tk-brand" href="{{.Home}}">
        {{if .LogoURL}}<img class="tk-brand-logo" src="{{.LogoURL}}" alt="{{.SiteName}}">{{else}}<span class="tk-brand-text">{{initial .SiteName}}</span>{{end}}
      </a>
      {{if .SiteDesc}}<p>{{.SiteDesc}}</p>{{end}}
      {{if .Socials}}
      <ul class="tk-social" aria-label="{{.T "layout.social"}}">
        {{range .Socials}}<li><a href="{{.URL}}" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{$.SocialLabel .Platform}}" data-tip="{{$.SocialLabel .Platform}}">{{socialIcon .Platform}}</a></li>{{end}}
      </ul>
      {{end}}
    </div>
    {{if .FooterNavs}}
    {{/* 页脚导航（后台「导航管理 → 页脚」）：顶级项 = 一列标题，子项 = 该列链接；
         没配就回退内置的产品/资源两列。 */}}
    {{range .FooterNavs}}
    <nav class="tk-footer-col" aria-label="{{.Label}}">
      <h4>{{.Label}}</h4>
      {{range .Children}}<a href="{{$.URL .Href}}"{{if or (hasPrefix .Href "http") (hasPrefix .Href "mailto:")}} target="_blank" rel="noopener noreferrer nofollow"{{end}}>{{.Label}}</a>{{end}}
    </nav>
    {{end}}
    {{else}}
    <nav class="tk-footer-col" aria-label="{{.T "layout.product"}}">
      <h4>{{.T "layout.product"}}</h4>
      <a href="{{.URL "/products"}}">{{.T "theme.torkon.allProducts"}}</a>
    </nav>
    {{if .Posts}}
    <nav class="tk-footer-col" aria-label="{{.T "layout.resources"}}">
      <h4>{{.T "layout.resources"}}</h4>
      <a href="{{.URL "/news"}}">{{.T "layout.news"}}</a>
    </nav>
    {{end}}
    {{end}}
    <nav class="tk-footer-col" aria-label="{{.T "layout.contact"}}">
      <h4>{{.T "layout.contact"}}</h4>
      {{range .Navs}}{{if eq .Href "/p/about"}}<a href="{{$.URL .Href}}">{{.Label}}</a>{{end}}{{end}}
      <a href="{{.URL "/contact"}}">{{.T "layout.contactUs"}}</a>
    </nav>
    <nav class="tk-footer-col" aria-label="{{.T "theme.torkon.footerSupport"}}">
      <h4>{{.T "theme.torkon.footerSupport"}}</h4>
      <a href="{{.URL "/contact"}}">{{.T "theme.torkon.catalogTitle"}}</a>
      <a href="{{.URL "/products"}}">{{.T "theme.torkon.selectionTitle"}}</a>
      <a href="{{.URL "/contact"}}">{{.T "theme.torkon.findDealer"}}</a>
    </nav>
    <div class="tk-footer-col tk-footer-sub">
      <h4>{{.T "theme.torkon.footerSubscribe"}}</h4>
      <p>{{.T "theme.torkon.footerSubscribeSub"}}</p>
      <a class="tk-btn tk-btn-red" href="{{.BaseURL}}/rss.xml">{{.T "theme.torkon.footerRss"}} <span aria-hidden="true">→</span></a>
      {{if .QRCodeURL}}
      <figure class="tk-footer-qr">
        <img src="{{.QRCodeURL}}" alt="{{if .QRCodeCaption}}{{.QRCodeCaption}}{{else}}{{.T "layout.qrAlt"}}{{end}}" loading="lazy" width="104" height="104">
        {{if .QRCodeCaption}}<figcaption>{{.QRCodeCaption}}</figcaption>{{end}}
      </figure>
      {{end}}
    </div>
  </div>
  <div class="tk-wrap tk-footer-bottom">
    <span>© {{.Year}} {{.SiteName}} · {{.T "theme.torkon.rights"}}</span>
    {{if .ContactEmail}}<a class="tk-footer-mail" href="mailto:{{.ContactEmail}}" data-copy-email="{{.ContactEmail}}" title="{{.T "site.js.emailCopy"}}">{{.ContactEmail}}</a>{{end}}
    {{if .ICP}}<a class="tk-footer-icp" href="https://beian.miit.gov.cn/" rel="noopener noreferrer" target="_blank">{{.ICP}}</a>{{end}}
    {{if .FooterNote}}<span>{{.FooterNote}}</span>{{end}}
  </div>
</footer>
<!-- 在线客服挂件：沿用 website 插件的挂件与脚本；没装 im 插件时探测 404 自动隐藏。 -->
<div class="chat" data-chat data-online="1" hidden>
  <button class="chat-launcher" type="button" data-chat-open aria-haspopup="dialog" aria-expanded="false" aria-controls="chat-panel" aria-label="{{.T "chat.open"}}">
    {{uiIcon "message"}}
    <span>{{.T "chat.launcher"}}</span>
  </button>
  <section class="chat-panel" id="chat-panel" data-chat-panel role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
    <header class="chat-head">
      <div class="chat-identity">
        <span class="chat-avatar" aria-hidden="true">{{uiIcon "message"}}</span>
        <div class="chat-identity-text">
          <strong id="chat-title">{{.T "chat.title"}}</strong>
          <span class="chat-agent" data-chat-agent hidden><span data-chat-agent-name></span> <span data-chat-agent-time></span></span>
        </div>
      </div>
      <button class="chat-tool chat-expand" type="button" data-chat-expand aria-label="{{.T "chat.expand"}}" title="{{.T "chat.expand"}}" aria-pressed="false">
        <span class="chat-ico-expand">{{uiIcon "maximize"}}</span>
        <span class="chat-ico-restore">{{uiIcon "minimize"}}</span>
      </button>
      <button class="chat-close" type="button" data-chat-close aria-label="{{.T "chat.close"}}">{{uiIcon "close"}}</button>
    </header>
    <p class="chat-offline" data-chat-offline hidden>{{.T "chat.offline"}}</p>
    <p class="chat-assurance">{{.T "chat.assurance"}}</p>
    <div class="chat-log" data-chat-log role="log" aria-live="polite" aria-relevant="additions">
      <div class="chat-empty" data-chat-empty>
        <span class="chat-empty-mark" aria-hidden="true">{{uiIcon "message"}}</span>
        <p class="chat-empty-title">{{.T "chat.empty"}}</p>
        <p class="chat-empty-sub">{{.T "chat.emptySub"}}</p>
        <div class="chat-suggests">
          <button type="button" data-chat-suggest>{{.T "chat.suggestDeploy"}}</button>
          <button type="button" data-chat-suggest>{{.T "chat.suggestCustom"}}</button>
        </div>
      </div>
    </div>
    <p class="chat-typing" data-chat-typing hidden>{{.T "chat.typing"}}</p>
    <form class="chat-form" data-chat-form>
      <label class="sr-only" for="chat-input">{{.T "chat.inputLabel"}}</label>
      <div class="chat-product" data-chat-product hidden>
        <span class="chat-product-cover" data-chat-product-cover></span>
        <span class="chat-product-info">
          <strong data-chat-product-title></strong>
          <span data-chat-product-price></span>
          <span data-chat-product-moq></span>
        </span>
        <button class="chat-product-remove" type="button" data-chat-product-remove aria-label="{{.T "chat.removeProduct"}}">×</button>
      </div>
      <div class="chat-emoji-pop" data-chat-emoji-pop hidden></div>
      <div class="chat-compose">
        <textarea id="chat-input" data-chat-input rows="1" maxlength="2000" placeholder="{{.T "chat.placeholder"}}" aria-label="{{.T "chat.inputLabel"}}"></textarea>
        <div class="chat-compose-bar">
          <button class="chat-tool" type="button" data-chat-emoji aria-label="{{.T "chat.emoji"}}" title="{{.T "chat.emoji"}}">{{uiIcon "mood-smile"}}</button><button class="chat-tool" type="button" data-chat-translate aria-label="{{.T "chat.translate"}}" title="{{.T "chat.translate"}}">{{uiIcon "language"}}</button>
          <button class="chat-attach" type="button" data-chat-attach aria-label="{{.T "chat.attach"}}" title="{{.T "chat.attach"}}">{{uiIcon "paperclip"}}</button>
          <span class="chat-hint" aria-hidden="true">{{.T "chat.inputHint"}}</span>
          <button class="chat-tool chat-clear" type="button" data-chat-clear aria-label="{{.T "chat.clear"}}" title="{{.T "chat.clear"}}">{{uiIcon "eraser"}}</button>
          <button class="chat-send" type="submit" data-chat-send aria-label="{{.T "chat.send"}}">{{uiIcon "send"}}</button>
        </div>
      </div>
      <input type="file" data-chat-file hidden accept="image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,.zip,.docx,.xlsx,.pptx">
    </form>
    <div class="chat-closed" data-chat-closed hidden>
      <p class="chat-closed-title" data-chat-closed-title>{{.T "chat.closedTitle"}}</p>
      <div class="chat-rating" data-chat-rating hidden>
        <p class="chat-rating-title" data-chat-rating-title>{{.T "chat.rateTitle"}}</p>
        <div class="chat-stars" data-chat-stars role="group" aria-label="{{.T "chat.rateTitle"}}">
          <button type="button" data-rate="1" aria-label="1">★</button>
          <button type="button" data-rate="2" aria-label="2">★</button>
          <button type="button" data-rate="3" aria-label="3">★</button>
          <button type="button" data-rate="4" aria-label="4">★</button>
          <button type="button" data-rate="5" aria-label="5">★</button>
        </div>
        <p class="chat-thanks" data-chat-thanks hidden>{{.T "chat.rateThanks"}}</p>
        <textarea data-chat-rating-comment rows="2" maxlength="500" placeholder="{{.T "chat.rateComment"}}" aria-label="{{.T "chat.rateComment"}}"></textarea>
        <button type="button" class="chat-new" data-chat-rating-submit disabled>{{.T "chat.rateSubmit"}}</button>
      </div>
      <button type="button" class="chat-new" data-chat-new>{{.T "chat.startNew"}}</button>
    </div>
  </section>
</div>
<script type="application/json" id="site-i18n">{{.JSStrings}}</script>
<script type="application/json" id="site-langs">{{.LangsJSON}}</script>
<script src="/website-assets/chat-widget.js?v={{assetV "chat-widget.js"}}" defer></script>
<script src="/website-assets/site.js?v={{assetV "site.js"}}" defer></script>
<script src="/website-assets/chat-enhance.js?v={{assetV "chat-enhance.js"}}" defer></script>
</body>
</html>{{end}}

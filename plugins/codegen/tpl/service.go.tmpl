func to[[.Sub.Pascal]]View(m *[[.Sub.Pascal]]) [[.Sub.Pascal]]View {
	return [[.Sub.Pascal]]View{
		ID: m.ID,
[[- range .Sub.Fields]]
		[[.Pascal]]: m.[[.Pascal]],
[[- end]]

func (s *Service) get(ctx context.Context, id idgen.ID) (*[[.Pascal]], error) {
	var m [[.Pascal]]
	err := s.db.WithContext(ctx).First(&m, "id = ?", int64(id)).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, response.NotFound("error.not_found")
	}
	return &m, err
}

// List 分页列表，按 id 倒序（新的在前）。
func (s *Service) List(ctx context.Context, q ListQuery) ([]View, int64, error) {
	base := s.db.WithContext(ctx).Model(&[[.Pascal]]{})
[[- range .QueryFields]]
[[- if eq .QueryOp "like"]]
	if q.[[.Pascal]] != "" {
		base = base.Where(clause.Like{Column: clause.Column{Name: "[[.Name]]"}, Value: likeArg(q.[[.Pascal]])})
	}
[[- else if eq .QueryOp "between"]]
	if q.[[.Pascal]]From != nil {
		base = base.Where(clause.Gte{Column: clause.Column{Name: "[[.Name]]"}, Value: *q.[[.Pascal]]From})
	}
	if q.[[.Pascal]]To != nil {
[[- if eq .Kind "datetime"]]
		// 日期时间区间按天：右端取次日零点（不含），否则当天 00:00 之后的数据会被漏掉。
		base = base.Where(clause.Lt{Column: clause.Column{Name: "[[.Name]]"}, Value: q.[[.Pascal]]To.Add(24 * time.Hour)})
[[- else]]
		base = base.Where(clause.Lte{Column: clause.Column{Name: "[[.Name]]"}, Value: *q.[[.Pascal]]To})
[[- end]]
	}
[[- else if eq .Kind "string"]]
	if q.[[.Pascal]] != "" {
		base = base.Where(clause.[[clause .QueryOp]]{Column: clause.Column{Name: "[[.Name]]"}, Value: q.[[.Pascal]]})
	}
[[- else]]
	if q.[[.Pascal]] != nil {
		base = base.Where(clause.[[clause .QueryOp]]{Column: clause.Column{Name: "[[.Name]]"}, Value: *q.[[.Pascal]]})
	}
[[- end]]
[[- end]]
	base = base.Session(&gorm.Session{})
	var total int64
	if err := base.Count(&total).Error; err != nil {
		return nil, 0, err
	}
	var rows [][[.Pascal]]
	err := base.Order("id DESC").Offset((q.Page - 1) * q.PageSize).Limit(q.PageSize).Find(&rows).Error
	if err != nil {
		return nil, 0, err
	}
	out := make([]View, len(rows))
	for i := range rows {
		out[i] = toView(&rows[i])
	}
	return out, total, nil
}

// Get 返回详情。
func (s *Service) Get(ctx context.Context, id idgen.ID) (*View, error) {
	m, err := s.get(ctx, id)
	if err != nil {
		return nil, err
	}
	v := toView(m)
[[- if .Sub]]
	var kids [][[.Sub.Pascal]]
	if err := s.db.WithContext(ctx).Where("[[.Sub.FK]] = ?", int64(m.ID)).Order("id ASC").Find(&kids).Error; err == nil {
		v.Children = make([][[.Sub.Pascal]]View, 0, len(kids))
		for i := range kids {
			v.Children = append(v.Children, to[[.Sub.Pascal]]View(&kids[i]))
		}
	}
[[- end]]
	return &v, nil
}

// Save 新增（id 为 0）或修改。
func (s *Service) Save(ctx context.Context, id idgen.ID, f Form) (*View, error) {
	var m [[.Pascal]]
	if id != 0 {
		cur, err := s.get(ctx, id)
		if err != nil {
			return nil, err
		}
		m = *cur
	}
	if err := f.apply(&m); err != nil {
		return nil, err
	}
[[- if .Sub]]
	// 主表与子行一个事务：子行整存整取（清旧插新，ID 每次重新生成），挂一半算保存失败。
	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		if id == 0 {
[[- if eq .Shape "plain"]]
			nid, err := idgen.Next()
			if err != nil {
				return err
			}
			m.ID = nid
[[- if .Tenant]]
			tid, ok := tn.From(ctx)
			if !ok {
				return response.BadRequest("error.bad_request").WithMsg("missing tenant")
			}
			m.TenantID = tid
[[- end]]
[[- end]]
			if err := tx.Create(&m).Error; err != nil {
				return err
			}
		} else if err := tx.Save(&m).Error; err != nil {
			return err
		}
		// 子行整存整取：清掉旧子行再整批插入（客户端不传子行 ID）。
		if err := tx.Where("[[.Sub.FK]] = ?", int64(m.ID)).Delete(&[[.Sub.Pascal]]{}).Error; err != nil {
			return err
		}
			for i := range f.Children {
				kid := [[.Sub.Pascal]]{[[.Sub.FKPascal]]: m.ID}
[[- if and .Sub.Tenant (eq .Sub.Shape "plain")]]
				kid.TenantID = m.TenantID
[[- end]]
				if err := f.Children[i].apply(&kid); err != nil {
					return err
				}
				nid, err := idgen.Next()
				if err != nil {
					return err
				}
				kid.ID = nid
				if err := tx.Create(&kid).Error; err != nil {
					return err
				}
			}
			return nil
		})
		if err != nil {
			return nil, err
		}
[[- else]]
	db := s.db.WithContext(ctx)
	if id == 0 {
[[- if eq .Shape "plain"]]
		nid, err := idgen.Next()
		if err != nil {
			return nil, err
		}
		m.ID = nid
[[- if .Tenant]]
		tid, ok := tn.From(ctx)
		if !ok {
			return nil, response.BadRequest("error.bad_request").WithMsg("missing tenant")
		}
		m.TenantID = tid
[[- end]]
[[- end]]
		if err := db.Create(&m).Error; err != nil {
			return nil, err
		}
	} else if err := db.Save(&m).Error; err != nil {
		return nil, err
	}
[[- end]]
	v := toView(&m)
	return &v, nil
}

// Delete 删除（不存在的 ID 忽略）。
func (s *Service) Delete(ctx context.Context, ids []idgen.ID) error {
	return s.db.WithContext(ctx).Where("id IN ?", ids64(ids)).Delete(&[[.Pascal]]{}).Error
}

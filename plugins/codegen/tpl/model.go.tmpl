// TableName 指定表名。
func ([[.Pascal]]) TableName() string { return "[[.Table]]" }

// View 是接口返回的表示（ID 一律序列化为字符串）。
type View struct {
	ID idgen.ID `json:"id"`
[[- range .Fields]]
